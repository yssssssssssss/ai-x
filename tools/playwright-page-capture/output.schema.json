{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "playwright-page-capture/output.schema.json",
  "title": "PlaywrightPageCaptureOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["captures", "failures", "security_profile"],
  "properties": {
    "captures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachment_id", "source_result_index", "requested_url", "final_url", "page_title",
          "captured_at", "capture_mode", "viewport", "media_type", "width", "height",
          "byte_size", "content_sha256", "truncated"
        ],
        "properties": {
          "attachment_id": { "type": "string", "pattern": "^capture-[1-9][0-9]*$" },
          "source_result_index": { "type": "integer", "minimum": 0, "maximum": 19 },
          "requested_url": { "type": "string", "format": "uri" },
          "final_url": { "type": "string", "format": "uri" },
          "page_title": { "type": "string", "maxLength": 300 },
          "captured_at": { "type": "string", "format": "date-time" },
          "capture_mode": {
            "type": "string",
            "enum": ["extracted_image", "element_screenshot", "full_page_screenshot"]
          },
          "selector": { "type": "string", "minLength": 1, "maxLength": 512 },
          "viewport": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": { "type": "integer", "minimum": 1024, "maximum": 1920 },
              "height": { "type": "integer", "minimum": 720, "maximum": 1200 }
            }
          },
          "media_type": { "const": "image/png" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1, "maximum": 12000 },
          "byte_size": { "type": "integer", "minimum": 1, "maximum": 10485760 },
          "content_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "truncated": { "type": "boolean" }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_result_index", "requested_url", "code", "sanitized_message"],
        "properties": {
          "source_result_index": { "type": "integer", "minimum": 0, "maximum": 19 },
          "requested_url": { "type": "string", "format": "uri" },
          "code": {
            "type": "string",
            "enum": [
              "login_required", "captcha_required", "paywall", "robots_or_terms_blocked",
              "navigation_timeout", "no_capture_target", "unsupported_content"
            ]
          },
          "sanitized_message": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "security_profile": { "const": "browser-controls-v1" }
  }
}
