{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-bundle.schema.json",
  "title": "KnowledgeBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "planVersionId", "attemptId", "stepNo", "contractHash", "resources"],
  "properties": {
    "version": { "const": "knowledge-bundle-v1" },
    "taskId": { "type": "string", "minLength": 1 },
    "planVersionId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "stepNo": { "type": "integer", "minimum": 1 },
    "contractHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "sourcePath", "contentHash", "content"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "status": { "enum": ["approved", "draft"] },
          "sourcePath": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
