{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report-layout-blueprint-v1",
  "title": "Model-directed report layout blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sections"],
  "properties": {
    "version": { "const": "report-layout-blueprint-v1" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "purpose", "prominence", "blockRefs"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "purpose": { "$ref": "#/definitions/text" },
          "prominence": { "enum": ["primary", "supporting", "appendix"] },
          "blockRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/text" }
          }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" }
  }
}
