{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "design-audit-report.schema.json",
  "title": "DesignAuditReportPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pages",
    "issues",
    "principles",
    "severities",
    "annotatedScreenshots",
    "remediations",
    "retests"
  ],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/issue" }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/principle" }
    },
    "severities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/severity" }
    },
    "annotatedScreenshots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/annotatedScreenshot" }
    },
    "remediations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/remediation" }
    },
    "retests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/retest" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "state": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pageId", "statement"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "pageId": { "$ref": "#/$defs/nonEmptyString" },
        "statement": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "principle", "rationale"],
      "properties": {
        "issueId": { "$ref": "#/$defs/nonEmptyString" },
        "principle": { "$ref": "#/$defs/nonEmptyString" },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "level", "rationale"],
      "properties": {
        "issueId": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "enum": ["minor", "major", "critical"] },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "annotatedScreenshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "assetId", "annotation"],
      "properties": {
        "issueId": { "$ref": "#/$defs/nonEmptyString" },
        "assetId": { "$ref": "#/$defs/nonEmptyString" },
        "annotation": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "action", "acceptanceCriteria"],
      "properties": {
        "issueId": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/nonEmptyString" },
        "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "retest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueId", "method", "expectedResult"],
      "properties": {
        "issueId": { "$ref": "#/$defs/nonEmptyString" },
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "expectedResult": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
