{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-strategy-report-v2.schema.json",
  "title": "ResearchStrategyReportPayloadV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "decisionContext",
    "executiveAnswer",
    "directAnswers",
    "evidenceFindings",
    "contentBlocks",
    "limitations",
    "openQuestions",
    "riskDisclosures",
    "requestedArtifactBindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "research-strategy-content-v2"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "decisionContext": {
      "$ref": "#/$defs/text"
    },
    "executiveAnswer": {
      "$ref": "#/$defs/text"
    },
    "directAnswers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/directAnswer"
      }
    },
    "evidenceFindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceFinding"
      }
    },
    "contentBlocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentBlock"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "riskDisclosures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/riskDisclosure"
      }
    },
    "requestedArtifactBindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactBinding"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionIds",
        "evidenceIds",
        "confidence",
        "status",
        "validationNeeded"
      ],
      "properties": {
        "questionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "status": {
          "enum": [
            "supported",
            "provisional"
          ]
        },
        "validationNeeded": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "provisional"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "validationNeeded": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      ]
    },
    "directAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "question",
        "answer",
        "answerStatus",
        "evidenceIds",
        "confidence",
        "businessImplication",
        "recommendedAction",
        "validationNeeded"
      ],
      "properties": {
        "questionId": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "answer": {
          "$ref": "#/$defs/text"
        },
        "answerStatus": {
          "enum": [
            "supported",
            "provisional",
            "unanswered"
          ]
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "businessImplication": {
          "$ref": "#/$defs/text"
        },
        "recommendedAction": {
          "$ref": "#/$defs/text"
        },
        "validationNeeded": {
          "type": "string"
        }
      }
    },
    "evidenceFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "support"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "narrativeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "content",
        "support"
      ],
      "properties": {
        "kind": {
          "const": "narrative"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "content": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "matrixCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "row",
        "column",
        "statement",
        "support"
      ],
      "properties": {
        "row": {
          "$ref": "#/$defs/text"
        },
        "column": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "matrixBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "rows",
        "columns",
        "cells"
      ],
      "properties": {
        "kind": {
          "enum": [
            "comparison_matrix",
            "strategy_map"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/matrixCell"
          }
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "mindNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "support"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "mindEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relationship"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/key"
        },
        "to": {
          "$ref": "#/$defs/key"
        },
        "relationship": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "mindModelBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "nodes",
        "edges"
      ],
      "properties": {
        "kind": {
          "const": "mind_model"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mindNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mindEdge"
          }
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "support"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "principlesBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "design_principles"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/principle"
          }
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "impact",
        "support"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "impact": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "opportunityBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "opportunity_backlog"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/opportunity"
          }
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "action",
        "ownerType",
        "rationale",
        "validationMethod",
        "support"
      ],
      "properties": {
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "ownerType": {
          "$ref": "#/$defs/text"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "validationMethod": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "actionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "items"
      ],
      "properties": {
        "kind": {
          "enum": [
            "prioritized_actions",
            "action_plan"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "role",
        "strategies",
        "support"
      ],
      "properties": {
        "channel": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "strategies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "support": {
          "$ref": "#/$defs/support"
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "channelBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "channel_strategies"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "id": {
          "$ref": "#/$defs/key"
        }
      }
    },
    "contentBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/narrativeBlock"
        },
        {
          "$ref": "#/$defs/matrixBlock"
        },
        {
          "$ref": "#/$defs/mindModelBlock"
        },
        {
          "$ref": "#/$defs/principlesBlock"
        },
        {
          "$ref": "#/$defs/opportunityBlock"
        },
        {
          "$ref": "#/$defs/actionBlock"
        },
        {
          "$ref": "#/$defs/channelBlock"
        }
      ]
    },
    "riskDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceType",
        "sourceId",
        "statement",
        "disposition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "sourceType": {
          "enum": [
            "requirement_ambiguity",
            "skill_degraded_gap",
            "reviewer_condition",
            "envelope_risk",
            "answer_uncertainty"
          ]
        },
        "sourceId": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "disposition": {
          "enum": [
            "limitation",
            "open_question"
          ]
        }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactType",
        "sourceField",
        "blockIds",
        "questionIds",
        "evidenceIds",
        "status"
      ],
      "properties": {
        "artifactType": {
          "enum": [
            "executive_answers",
            "research_report",
            "strategy_map",
            "mind_model",
            "design_principles",
            "opportunity_backlog",
            "prioritized_actions",
            "channel_strategies",
            "action_plan"
          ]
        },
        "sourceField": {
          "enum": [
            "/directAnswers",
            "/contentBlocks"
          ]
        },
        "blockIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "questionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "status": {
          "const": "complete"
        }
      }
    }
  }
}
