{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-plan.schema.json",
  "title": "ResearchPlanPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "researchGoal",
    "scope",
    "competitorSampling",
    "researchQuestions",
    "comparisonDimensions",
    "sourcePlan",
    "executionPlan",
    "collectionTemplate",
    "analysisMethods",
    "deliverables",
    "qualityChecks"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "researchGoal": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "competitorSampling": { "$ref": "#/$defs/competitorSampling" },
    "researchQuestions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "comparisonDimensions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/comparisonDimension" }
    },
    "sourcePlan": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourcePlanItem" }
    },
    "executionPlan": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executionPlanItem" }
    },
    "collectionTemplate": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/collectionTemplateItem" }
    },
    "analysisMethods": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "qualityChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market", "subjects", "timeWindow"],
      "properties": {
        "market": { "type": "string", "minLength": 1 },
        "subjects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeWindow": { "type": "string", "minLength": 1 }
      }
    },
    "competitorSampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "targetCount", "inclusionCriteria", "exclusionCriteria"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "targetCount": { "type": "integer", "minimum": 1 },
        "inclusionCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclusionCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comparisonDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "purpose", "collectionFields"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "collectionFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourcePlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceClass", "sourceTypes", "purpose"],
      "properties": {
        "evidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "sourceTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "executionPlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "activities", "duration", "outputs"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "duration": { "type": "string", "minLength": 1 },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "collectionTemplateItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "description", "evidenceRequired"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "evidenceRequired": { "type": "boolean" }
      }
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "public_source",
        "screenshot",
        "user_input",
        "knowledge",
        "dataset",
        "simulation",
        "derived"
      ]
    }
  }
}
