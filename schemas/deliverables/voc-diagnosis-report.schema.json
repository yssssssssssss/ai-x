{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voc-diagnosis-report.schema.json",
  "title": "VocDiagnosisReportPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasets",
    "themes",
    "frequencies",
    "sentiments",
    "representativeQuotes",
    "severities",
    "priorities"
  ],
  "properties": {
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/theme" }
    },
    "frequencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frequency" }
    },
    "sentiments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sentiment" }
    },
    "representativeQuotes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/representativeQuote" }
    },
    "severities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/severity" }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/priority" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "recordCount"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "recordCount": { "type": "integer", "minimum": 1 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "datasetIds", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "datasetIds": { "$ref": "#/$defs/nonEmptyStringArray" },
        "evidenceIds": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "frequency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeId", "count", "share"],
      "properties": {
        "themeId": { "$ref": "#/$defs/nonEmptyString" },
        "count": { "type": "integer", "minimum": 0 },
        "share": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sentiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeId", "label", "score"],
      "properties": {
        "themeId": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "enum": ["positive", "neutral", "negative", "mixed"] },
        "score": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "representativeQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeId", "quote", "evidenceId"],
      "properties": {
        "themeId": { "$ref": "#/$defs/nonEmptyString" },
        "quote": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeId", "level", "rationale"],
      "properties": {
        "themeId": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeId", "level", "rationale"],
      "properties": {
        "themeId": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "enum": ["P0", "P1", "P2", "P3"] },
        "rationale": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
