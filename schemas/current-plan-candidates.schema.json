{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "current-plan-candidates.schema.json",
  "title": "CurrentPlanCandidates",
  "description": "Current planning output containing two to four controlled candidate profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "candidateProfile": {
      "type": "string",
      "enum": ["speed", "depth", "breadth", "focused", "mixed_method", "decision", "remediation"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "rationale", "tradeoffs", "steps", "assumptions"],
      "properties": {
        "id": { "$ref": "#/$defs/candidateProfile" },
        "title": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "tradeoffs": { "type": "string", "minLength": 1 },
        "recommended": { "type": "boolean" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        },
        "assumptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/assumption" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_no", "step_name", "actor_type", "actor_id"],
      "properties": {
        "step_no": { "type": "integer", "minimum": 1 },
        "step_name": { "type": "string", "minLength": 1 },
        "actor_type": {
          "type": "string",
          "enum": ["tool", "skill", "llm", "reviewer"]
        },
        "actor_id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string" },
        "input": { "type": "object" },
        "requires_approval": { "type": "boolean" }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "editable"],
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "editable": { "type": "boolean" }
      }
    }
  }
}
