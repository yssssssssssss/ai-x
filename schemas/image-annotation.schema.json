{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "image-annotation-v1",
  "title": "Image Annotation Overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "original", "annotations"],
  "properties": {
    "version": { "const": "image-annotation-v1" },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "manifestArtifactId"],
      "properties": {
        "assetId": { "$ref": "#/definitions/nonEmptyString" },
        "manifestArtifactId": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/rectangle" },
          { "$ref": "#/definitions/dot" },
          { "$ref": "#/definitions/arrow" },
          { "$ref": "#/definitions/numberedCallout" }
        ]
      }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "coordinate": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/definitions/coordinate" },
        "y": { "$ref": "#/definitions/coordinate" }
      }
    },
    "common": {
      "type": "object",
      "required": ["findingId", "label", "severity"],
      "properties": {
        "findingId": { "$ref": "#/definitions/nonEmptyString" },
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "severity": { "$ref": "#/definitions/severity" }
      }
    },
    "rectangle": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "x", "y", "width", "height", "findingId", "label", "severity"],
          "properties": {
            "shape": { "const": "rectangle" },
            "x": { "$ref": "#/definitions/coordinate" },
            "y": { "$ref": "#/definitions/coordinate" },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "findingId": { "$ref": "#/definitions/nonEmptyString" },
            "label": { "$ref": "#/definitions/nonEmptyString" },
            "severity": { "$ref": "#/definitions/severity" }
          }
        }
      ]
    },
    "dot": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "x", "y", "findingId", "label", "severity"],
          "properties": {
            "shape": { "const": "dot" },
            "x": { "$ref": "#/definitions/coordinate" },
            "y": { "$ref": "#/definitions/coordinate" },
            "findingId": { "$ref": "#/definitions/nonEmptyString" },
            "label": { "$ref": "#/definitions/nonEmptyString" },
            "severity": { "$ref": "#/definitions/severity" }
          }
        }
      ]
    },
    "arrow": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "start", "end", "findingId", "label", "severity"],
          "properties": {
            "shape": { "const": "arrow" },
            "start": { "$ref": "#/definitions/point" },
            "end": { "$ref": "#/definitions/point" },
            "findingId": { "$ref": "#/definitions/nonEmptyString" },
            "label": { "$ref": "#/definitions/nonEmptyString" },
            "severity": { "$ref": "#/definitions/severity" }
          }
        }
      ]
    },
    "numberedCallout": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "x", "y", "number", "findingId", "label", "severity"],
          "properties": {
            "shape": { "const": "numbered_callout" },
            "x": { "$ref": "#/definitions/coordinate" },
            "y": { "$ref": "#/definitions/coordinate" },
            "number": { "type": "integer", "minimum": 1 },
            "findingId": { "$ref": "#/definitions/nonEmptyString" },
            "label": { "$ref": "#/definitions/nonEmptyString" },
            "severity": { "$ref": "#/definitions/severity" }
          }
        }
      ]
    }
  }
}
