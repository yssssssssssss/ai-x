{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "universal-editorial-showcase-intent-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profileId", "sections"],
  "properties": {
    "version": { "const": "universal-editorial-showcase-intent-v1" },
    "profileId": { "const": "universal-editorial-showcase-v1" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "title", "componentIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "role": { "enum": ["decision", "evidence", "analysis", "strategy", "execution", "validation", "risk"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 180 },
          "lead": { "type": "string", "minLength": 1, "maxLength": 500 },
          "componentIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
          }
        }
      }
    }
  }
}
