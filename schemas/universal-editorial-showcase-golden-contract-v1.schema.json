{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "universal-editorial-showcase-golden-contract-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile", "approvedBaseline", "references", "requirements"],
  "properties": {
    "version": { "const": "universal-editorial-showcase-golden-contract-v1" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256"],
      "properties": {
        "id": { "const": "universal-editorial-showcase-v1" },
        "contentSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "approvedBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "approval", "approvedAt", "htmlSha256", "specSha256", "validationSha256"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "approval": { "const": "human_approved" },
        "approvedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
        "htmlSha256": { "$ref": "#/$defs/hash" },
        "specSha256": { "$ref": "#/$defs/hash" },
        "validationSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "references": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["role", "contentSha256"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "contentSha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["desktopViewport", "minimumSectionCountForRichMaterial", "minimumTableCountForRichMaterial", "requiredComponentKinds", "requiredSelectors", "forbiddenPatterns", "principles"],
      "properties": {
        "desktopViewport": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": { "width": { "const": 1440 }, "height": { "const": 900 } }
        },
        "minimumSectionCountForRichMaterial": { "type": "integer", "minimum": 1, "maximum": 32 },
        "minimumTableCountForRichMaterial": { "type": "integer", "minimum": 0, "maximum": 16 },
        "requiredComponentKinds": { "$ref": "#/$defs/strings" },
        "requiredSelectors": { "$ref": "#/$defs/strings" },
        "forbiddenPatterns": { "$ref": "#/$defs/strings" },
        "principles": { "$ref": "#/$defs/strings" }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "strings": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
