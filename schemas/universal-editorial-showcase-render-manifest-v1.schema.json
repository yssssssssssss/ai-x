{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "universal-editorial-showcase-render-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profileId", "profileHash", "specHash", "htmlHash", "renderedComponents"],
  "properties": {
    "version": { "const": "universal-editorial-showcase-render-manifest-v1" },
    "profileId": { "const": "universal-editorial-showcase-v1" },
    "profileHash": { "$ref": "#/$defs/hash" },
    "specHash": { "$ref": "#/$defs/hash" },
    "htmlHash": { "$ref": "#/$defs/hash" },
    "renderedComponents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentId", "kind", "ownedUnitIds", "sourceUnitIds"],
        "properties": {
          "componentId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "kind": { "$ref": "#/$defs/kind" },
          "ownedUnitIds": { "$ref": "#/$defs/unitIds" },
          "sourceUnitIds": { "$ref": "#/$defs/unitIds" }
        }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "unitId": { "type": "string", "pattern": "^emu_[a-f0-9]{64}$" },
    "unitIds": {
      "type": "array", "maxItems": 1000, "uniqueItems": true,
      "items": { "$ref": "#/$defs/unitId" }
    },
    "kind": {
      "enum": ["editorial-hero", "evidence-boundary", "answer-chain", "metric-cards", "record-grid", "record-table", "deliverable-map", "dimension-table", "method-board", "matrix", "stage-flow", "relation-map", "priority-lanes", "validation-list", "risk-register", "narrative-list", "source-register", "analysis-appendix"]
    }
  }
}
