{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deliverable-validation-diagnostic-v1",
  "title": "Deliverable validation diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "planVersionId", "attemptId", "stage", "round", "issues", "fallbackApplied"],
  "properties": {
    "version": { "const": "deliverable-validation-diagnostic-v1" },
    "taskId": { "$ref": "#/definitions/text" },
    "planVersionId": { "$ref": "#/definitions/text" },
    "attemptId": { "$ref": "#/definitions/text" },
    "stage": { "enum": ["content_schema", "content_semantics", "canonical_assembly", "layout_blueprint"] },
    "round": { "type": "integer", "minimum": 0 },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "$ref": "#/definitions/text" },
          "jsonPointer": { "type": "string", "pattern": "^/" },
          "message": { "$ref": "#/definitions/text", "maxLength": 500 }
        }
      }
    },
    "fallbackApplied": { "type": "boolean" }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" }
  }
}
