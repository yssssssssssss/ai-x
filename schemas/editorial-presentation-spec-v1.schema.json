{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "editorial-presentation-spec-v1",
  "title": "Editorial Presentation Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "binding", "profileId", "generationMode",
    "showcaseOutlineSignature", "sections", "notices"
  ],
  "properties": {
    "version": { "const": "editorial-presentation-spec-v1" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId", "planVersionId", "attemptId", "deliverableArtifactId",
        "deliverableContentSha256", "reportReviewArtifactId"
      ],
      "properties": {
        "taskId": { "$ref": "#/definitions/nonEmptyString" },
        "planVersionId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "deliverableArtifactId": { "$ref": "#/definitions/nonEmptyString" },
        "deliverableContentSha256": { "$ref": "#/definitions/sha256" },
        "reportReviewArtifactId": { "$ref": "#/definitions/nonEmptyString" },
        "evidenceManifestArtifactId": { "$ref": "#/definitions/nonEmptyString" },
        "evidenceManifestContentSha256": { "$ref": "#/definitions/sha256" },
        "evidenceManifestHash": { "$ref": "#/definitions/sha256" }
      }
    },
    "profileId": { "const": "editorial-showcase-v1" },
    "generationMode": { "enum": ["model", "fallback"] },
    "showcaseOutlineSignature": { "$ref": "#/definitions/sha256" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/section" }
    },
    "notices": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "$ref": "#/definitions/nonEmptyString" },
          "severity": { "enum": ["info", "warning"] },
          "message": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/nonEmptyString" }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "variant", "emphasis", "span", "ownedUnitIds", "ownedLeafIds",
        "sourceLeafIds", "sourceContributionUnitIds", "evidenceIds", "title"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "kind": {
          "enum": [
            "editorial-hero", "evidence-boundary", "confidence-bars", "timeline",
            "profile-grid", "matrix", "stage-flow", "tension-map", "principle-list",
            "priority-lanes", "validation-list", "source-register", "narrative-list"
          ]
        },
        "variant": {
          "enum": [
            "statement", "split", "columns", "asymmetric", "ledger", "horizontal",
            "stepped", "two-sided", "lanes", "table", "list", "register"
          ]
        },
        "emphasis": { "enum": ["hero", "primary", "secondary"] },
        "span": { "enum": ["full", "wide", "half", "third"] },
        "ownedUnitIds": { "$ref": "#/definitions/uniqueStrings" },
        "ownedLeafIds": { "$ref": "#/definitions/uniqueStrings" },
        "sourceLeafIds": { "$ref": "#/definitions/uniqueStrings" },
        "sourceContributionUnitIds": { "$ref": "#/definitions/uniqueStrings" },
        "evidenceIds": { "$ref": "#/definitions/uniqueStrings" },
        "status": { "enum": ["supported", "provisional", "unanswered"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "title": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "layout", "prominence", "title", "components"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "purpose": {
          "enum": [
            "decision", "evolution", "profiles", "motivation", "journey", "principles",
            "actions", "validation", "evidence", "analysis", "full_analysis_appendix"
          ]
        },
        "layout": { "enum": ["single", "split", "columns", "asymmetric", "full"] },
        "prominence": { "enum": ["primary", "supporting", "appendix"] },
        "title": { "$ref": "#/definitions/nonEmptyString" },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/definitions/component" }
        }
      }
    }
  }
}
