{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "skill-execution-contract.schema.json",
  "title": "SkillExecutionContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "skill_id", "required_requirement_fields", "resources", "stages", "output_stage_id", "output_pointer", "degraded_policy"],
  "properties": {
    "version": { "const": "skill-execution-contract-v1" },
    "skill_id": { "type": "string", "minLength": 1 },
    "required_requirement_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/" }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "required", "accepted_statuses", "purpose", "failure_policy"],
        "properties": {
          "resource_id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "accepted_statuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["approved", "draft"] } },
          "purpose": { "type": "string", "minLength": 1 },
          "failure_policy": { "enum": ["block", "gap"] }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "title", "actor_type", "actor_id", "depends_on", "input", "input_bindings", "expected_outputs", "acceptance_criteria", "failure_policy"],
        "properties": {
          "stage_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "actor_type": { "enum": ["knowledge", "tool", "llm", "skill", "reviewer"] },
          "actor_id": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "input": { "type": "object" },
          "input_bindings": { "type": "array", "items": { "$ref": "#/$defs/stageBinding" } },
          "expected_outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expectedOutput" } },
          "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "failure_policy": { "enum": ["block", "gap"] }
        }
      }
    },
    "output_stage_id": { "type": "string", "minLength": 1 },
    "output_pointer": { "type": "string", "pattern": "^/" },
    "degraded_policy": { "enum": ["gap", "block"] }
  },
  "$defs": {
    "stageBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_pointer", "source_stage_id", "source_pointer"],
      "properties": {
        "target_pointer": { "type": "string", "pattern": "^/" },
        "source_stage_id": { "type": "string", "minLength": 1 },
        "source_pointer": { "type": "string", "pattern": "^/" }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "description"],
      "properties": {
        "pointer": { "type": "string", "pattern": "^/" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
