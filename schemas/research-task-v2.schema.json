{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-task-v2.schema.json",
  "title": "ResearchTaskV2",
  "description": "Current requirement refinement contract. Legacy ResearchTask remains read-only compatible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_type",
    "business_domain",
    "research_goal",
    "target_audience",
    "scope",
    "constraints",
    "success_criteria",
    "expected_deliverables",
    "assumptions",
    "ambiguities",
    "clarification_questions",
    "blocking_issues",
    "sensitivity",
    "pii_detected"
  ],
  "properties": {
    "version": { "const": "research-task-v2" },
    "task_type": {
      "type": "string",
      "enum": ["competitive_research", "user_research_planning", "research_synthesis", "voc_diagnosis", "design_audit", "a11y_audit", "industry_market_analysis"]
    },
    "outcome_mode": { "type": "string", "enum": ["plan", "answer"] },
    "requested_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["executive_answers", "research_report", "strategy_map", "mind_model", "design_principles", "opportunity_backlog", "prioritized_actions", "channel_strategies", "action_plan"]
      }
    },
    "industry_scope": { "$ref": "#/$defs/industry_scope" },
    "available_material_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/industry_material_role" }
    },
    "unavailable_material_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/industry_material_role" }
    },
    "business_domain": { "type": "string", "minLength": 1 },
    "research_goal": { "type": "string", "minLength": 1 },
    "comparison_dimensions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "target_audience": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/success_criterion" },
      "minItems": 1
    },
    "expected_deliverables": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ambiguity" }
    },
    "clarification_questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/clarification_question" }
    },
    "blocking_issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocking_issue" }
    },
    "sensitivity": { "type": "string", "enum": ["public", "internal", "confidential"] },
    "pii_detected": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "task_type": { "const": "industry_market_analysis" } },
        "required": ["task_type"]
      },
      "then": {
        "required": ["industry_scope", "available_material_roles", "unavailable_material_roles"]
      }
    }
  ],
  "$defs": {
    "industry_material_role": {
      "enum": [
        "jd_screenshots",
        "competitor_screenshots",
        "competitor_platform_names",
        "internal_documents",
        "user_research_dataset",
        "internal_metrics_dataset"
      ]
    },
    "industry_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "subcategories",
        "exclusions",
        "analysis_depth",
        "primary_focus",
        "secondary_focuses",
        "decision_audience",
        "decision_goal",
        "time_window"
      ],
      "properties": {
        "category": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "subcategories": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "analysis_depth": { "enum": ["light", "medium", "heavy"] },
        "primary_focus": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "secondary_focuses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "decision_audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "decision_goal": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "time_window": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "enum": ["user", "policy"] }
      }
    },
    "success_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "editable"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "editable": { "type": "boolean" }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "blocking"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" }
      }
    },
    "clarification_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "question", "rationale"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "ambiguity_id": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "pattern": "\\S" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "blocking_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "reason", "kind"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      }
    }
  }
}
