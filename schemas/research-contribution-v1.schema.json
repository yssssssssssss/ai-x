{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-contribution-v1.schema.json",
  "title": "ResearchContributionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "planVersionId",
    "attemptId",
    "invocationId",
    "skillId",
    "contributionTypes",
    "units",
    "limitations",
    "openQuestions"
  ],
  "properties": {
    "version": { "const": "research-contribution-v1" },
    "taskId": { "$ref": "#/$defs/text" },
    "planVersionId": { "$ref": "#/$defs/text" },
    "attemptId": { "$ref": "#/$defs/text" },
    "invocationId": { "$ref": "#/$defs/id" },
    "skillId": { "$ref": "#/$defs/id" },
    "contributionTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contributionType" }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    },
    "limitations": { "$ref": "#/$defs/textList" },
    "openQuestions": { "$ref": "#/$defs/textList" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "textList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "contributionType": {
      "enum": [
        "market_landscape",
        "competitive_analysis",
        "persona",
        "jobs_to_be_done",
        "journey",
        "qualitative_insight",
        "voc",
        "satisfaction",
        "metrics",
        "funnel",
        "feature_adoption",
        "design_audit",
        "accessibility",
        "research_method",
        "prioritization",
        "strategy",
        "action_plan",
        "virtual_user_hypothesis"
      ]
    },
    "requestedArtifact": {
      "enum": [
        "executive_answers",
        "research_report",
        "strategy_map",
        "mind_model",
        "design_principles",
        "opportunity_backlog",
        "prioritized_actions",
        "channel_strategies",
        "action_plan"
      ]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionIds",
        "evidenceIds",
        "status",
        "confidence",
        "validationNeeded"
      ],
      "properties": {
        "questionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "status": { "enum": ["supported", "provisional"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "validationNeeded": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "supported" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidenceIds": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "provisional" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "validationNeeded": { "$ref": "#/$defs/text" } }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "title",
        "statement",
        "requestedArtifactTypes",
        "support"
      ],
      "properties": {
        "key": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "observation",
            "finding",
            "insight",
            "hypothesis",
            "persona",
            "job",
            "journey_stage",
            "metric",
            "method",
            "priority",
            "recommendation",
            "action",
            "artifact_item"
          ]
        },
        "title": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "businessImplication": { "$ref": "#/$defs/text" },
        "recommendedAction": { "$ref": "#/$defs/text" },
        "requestedArtifactTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requestedArtifact" }
        },
        "support": { "$ref": "#/$defs/support" }
      }
    }
  }
}
