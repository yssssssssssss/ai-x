{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-report.schema.json",
  "title": "ResearchReport",
  "description": "段4 交付的需求驱动研究报告。写入 artifacts(artifact_type=report)。以研究子问题为组织轴:全局证据池 findings + 子问题(发现/分析/小结)+ 总体结论。",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "research_goal", "method_summary", "findings", "sub_questions", "overall_conclusion", "timeline", "deliverables", "capability_orchestration"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "research_goal": { "type": "string", "minLength": 1 },
    "method_summary": { "type": "string", "minLength": 1, "description": "研究方法概述(一句话):本研究用了哪些检索/分析能力。研究方法节由此 + capability_orchestration + timeline 派生渲染。" },
    "findings": {
      "type": "array",
      "description": "全局证据池。每条带全局唯一 id 与来源标注(schema 强制)。sub_questions 通过 id 引用。",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "sub_questions": {
      "type": "array",
      "description": "研究子问题(段4 事后拆解)。每个议题挂相关发现 id + 分析 + 小结。",
      "minItems": 1,
      "items": { "$ref": "#/$defs/subQuestion" }
    },
    "overall_conclusion": {
      "type": "array",
      "description": "总体结论与建议,由各子问题小结汇总。",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "timeline": {
      "type": "array",
      "description": "执行流程 + 周次。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "activity"],
        "properties": {
          "phase": { "type": "string", "description": "阶段,如 W28。" },
          "activity": { "type": "string", "minLength": 1 }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "description": "产出物清单。",
      "items": { "type": "string", "minLength": 1 }
    },
    "capability_orchestration": {
      "type": "array",
      "description": "能力编排:本次调用了哪些 skill/tool 及其用途。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "capability_type", "purpose"],
        "properties": {
          "capability_id": { "type": "string", "minLength": 1 },
          "capability_type": { "type": "string", "enum": ["skill", "tool"] },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "risks_and_open_issues": {
      "type": "array",
      "description": "风险与待人工确认项(need_annotate/need_approval 沉淀于此)。",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F[0-9]+$",
          "description": "全局唯一发现编号,如 F1。sub_questions.finding_ids 与 analysis.based_on 引用它。"
        },
        "statement": { "type": "string", "minLength": 1 },
        "source": {
          "type": "string",
          "description": "来源标注,schema 强制存在。",
          "enum": ["user_input", "knowledge_base", "tool_result", "llm_inference", "pending_human_review"]
        },
        "source_ref": {
          "type": "string",
          "description": "来源可反查引用,如 knowledge id / tool output ref / URL。"
        }
      }
    },
    "subQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "finding_ids", "analysis", "summary"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "description": "研究子问题。" },
        "finding_ids": {
          "type": "array",
          "description": "本议题相关的发现 id(引用完整性由 validator 语义校验)。",
          "items": { "type": "string", "pattern": "^F[0-9]+$" }
        },
        "analysis": {
          "type": "array",
          "description": "分析结论。每条强制引用其所依据的发现 id。",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "based_on"],
            "properties": {
              "statement": { "type": "string", "minLength": 1 },
              "based_on": {
                "type": "array",
                "description": "该分析结论依据的发现 id(引用完整性由 validator 语义校验)。",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^F[0-9]+$" }
              }
            }
          }
        },
        "summary": { "type": "string", "minLength": 1, "description": "本子问题小结。" }
      }
    }
  }
}
