{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "editorial-report-blueprint.schema.json",
  "title": "Editorial Report Blueprint Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "locale", "deck", "sections"],
  "properties": {
    "version": { "const": "editorial-blueprint-plan-v1" },
    "locale": { "const": "zh-CN" },
    "title": { "$ref": "#/$defs/copy" },
    "deck": { "$ref": "#/$defs/copy" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "copy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "mode", "materialUnitIds"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 16000 },
            "mode": { "const": "verbatim" },
            "materialUnitIds": {
              "allOf": [
                { "$ref": "#/$defs/identifierArray" },
                { "minItems": 1, "maxItems": 1 }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "mode", "materialUnitIds"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 600 },
            "mode": { "const": "paraphrase" },
            "materialUnitIds": {
              "allOf": [
                { "$ref": "#/$defs/identifierArray" },
                { "minItems": 1, "maxItems": 16 }
              ]
            }
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "questionIds", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": {
          "enum": [
            "decision", "positioning", "audience", "motivation", "journey", "strategy",
            "opportunity", "roadmap", "validation", "risk", "boundary"
          ]
        },
        "questionIds": {
          "allOf": [
            { "$ref": "#/$defs/identifierArray" },
            { "maxItems": 1000 }
          ]
        },
        "title": { "$ref": "#/$defs/copy" },
        "lead": { "$ref": "#/$defs/copy" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": { "$ref": "#/$defs/plannedBlock" }
        }
      }
    },
    "plannedBlock": {
      "oneOf": [
        { "$ref": "#/$defs/narrative" },
        { "$ref": "#/$defs/decisionCover" },
        { "$ref": "#/$defs/metricCards" },
        { "$ref": "#/$defs/truthTriad" },
        { "$ref": "#/$defs/cardGrid" },
        { "$ref": "#/$defs/flow" },
        { "$ref": "#/$defs/strategyMatrix" },
        { "$ref": "#/$defs/roadmap" },
        { "$ref": "#/$defs/validationGates" },
        { "$ref": "#/$defs/riskRegister" },
        { "$ref": "#/$defs/visualGallery" }
      ]
    },
    "narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "paragraphs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "narrative" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/copy" }
        }
      }
    },
    "decisionCover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "decision-cover" },
        "summary": { "$ref": "#/$defs/copy" },
        "boundary": { "$ref": "#/$defs/copy" }
      }
    },
    "metricCards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "metric-cards" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "valueUnitId"],
                "properties": {
                  "label": { "$ref": "#/$defs/copy" },
                  "valueUnitId": { "$ref": "#/$defs/identifier" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["labelKey", "valueUnitId"],
                "properties": {
                  "labelKey": { "const": "target-sample-count" },
                  "valueUnitId": { "$ref": "#/$defs/identifier" }
                }
              }
            ]
          }
        }
      }
    },
    "truthTriad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "factIds", "inferenceIds", "unknownIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "truth-triad" },
        "factIds": { "allOf": [{ "$ref": "#/$defs/identifierArray" }, { "maxItems": 1000 }] },
        "inferenceIds": { "allOf": [{ "$ref": "#/$defs/identifierArray" }, { "maxItems": 1000 }] },
        "unknownIds": { "allOf": [{ "$ref": "#/$defs/identifierArray" }, { "maxItems": 1000 }] }
      },
      "anyOf": [
        { "properties": { "factIds": { "minItems": 1 } } },
        { "properties": { "inferenceIds": { "minItems": 1 } } },
        { "properties": { "unknownIds": { "minItems": 1 } } }
      ]
    },
    "cardGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "cards"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "card-grid" },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "$ref": "#/$defs/copy" },
              "body": { "$ref": "#/$defs/copy" }
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "flow" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "body"],
            "properties": {
              "label": { "$ref": "#/$defs/copy" },
              "body": { "$ref": "#/$defs/copy" }
            }
          }
        }
      }
    },
    "strategyMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "columns", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "strategy-matrix" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/copy" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "cells"],
            "properties": {
              "label": { "$ref": "#/$defs/copy" },
              "cells": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "$ref": "#/$defs/copy" }
              }
            }
          }
        }
      }
    },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "lanes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "roadmap" },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "items"],
            "properties": {
              "label": { "$ref": "#/$defs/copy" },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": { "$ref": "#/$defs/copy" }
              }
            }
          }
        }
      }
    },
    "validationGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "gates"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "validation-gates" },
        "gates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "method"],
            "properties": {
              "label": { "$ref": "#/$defs/copy" },
              "method": { "$ref": "#/$defs/copy" },
              "successCriterion": { "$ref": "#/$defs/copy" }
            }
          }
        }
      }
    },
    "riskRegister": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "risk-register" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["risk"],
            "properties": {
              "risk": { "$ref": "#/$defs/copy" },
              "impact": { "$ref": "#/$defs/copy" },
              "response": { "$ref": "#/$defs/copy" }
            }
          }
        }
      }
    },
    "visualGallery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "assetIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "visual-gallery" },
        "assetIds": {
          "allOf": [
            { "$ref": "#/$defs/identifierArray" },
            { "minItems": 1, "maxItems": 6 }
          ]
        }
      }
    }
  }
}
