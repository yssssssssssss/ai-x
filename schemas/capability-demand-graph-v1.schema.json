{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "capability-demand-graph-v1.schema.json",
  "title": "CapabilityDemandGraphV1",
  "description": "Planning-only capability obligations derived from a finalized task and ProblemGraph.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "demands"],
  "properties": {
    "version": { "const": "capability-demand-graph-v1" },
    "demands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/demand" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "contributionType": {
      "type": "string",
      "enum": [
        "market_landscape",
        "competitive_analysis",
        "persona",
        "jobs_to_be_done",
        "journey",
        "qualitative_insight",
        "voc",
        "satisfaction",
        "metrics",
        "funnel",
        "feature_adoption",
        "design_audit",
        "accessibility",
        "research_method",
        "prioritization",
        "strategy",
        "action_plan",
        "virtual_user_hypothesis"
      ]
    },
    "requestedArtifact": {
      "type": "string",
      "enum": [
        "executive_answers",
        "research_report",
        "strategy_map",
        "mind_model",
        "design_principles",
        "opportunity_backlog",
        "prioritized_actions",
        "channel_strategies",
        "action_plan"
      ]
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "public_source",
        "screenshot",
        "user_input",
        "knowledge",
        "dataset",
        "simulation",
        "derived"
      ]
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "questionIds",
        "requestedArtifactTypes",
        "requiredEvidenceClasses",
        "requiredInputRoles",
        "priority"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/contributionType" },
        "questionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requestedArtifactTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requestedArtifact" }
        },
        "requiredEvidenceClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceClass" }
        },
        "requiredInputRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "priority": { "enum": ["required", "optional"] }
      }
    }
  }
}
