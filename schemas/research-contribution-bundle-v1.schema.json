{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-contribution-bundle-v1.schema.json",
  "title": "ResearchContributionBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "planVersionId", "attemptId", "orderedInvocationIds", "entries", "gaps"],
  "properties": {
    "version": { "const": "research-contribution-bundle-v1" },
    "taskId": { "$ref": "#/$defs/text" },
    "planVersionId": { "$ref": "#/$defs/text" },
    "attemptId": { "$ref": "#/$defs/text" },
    "orderedInvocationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocationId", "skillId", "artifactId", "artifactContentSha256", "contribution"],
      "properties": {
        "invocationId": { "$ref": "#/$defs/text" },
        "skillId": { "$ref": "#/$defs/text" },
        "artifactId": { "$ref": "#/$defs/text" },
        "artifactContentSha256": { "$ref": "#/$defs/hash" },
        "contribution": {
          "type": "object",
          "required": ["version", "taskId", "planVersionId", "attemptId", "invocationId", "skillId", "contributionTypes", "units", "limitations", "openQuestions"]
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocationId", "skillId", "reason"],
      "properties": {
        "invocationId": { "$ref": "#/$defs/text" },
        "skillId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    }
  }
}
