{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contribution-ledger-v1.schema.json",
  "title": "ContributionLedgerV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "taskId", "planVersionId", "attemptId", "entries"],
  "properties": {
    "version": { "const": "contribution-ledger-v1" },
    "taskId": { "$ref": "#/$defs/text" },
    "planVersionId": { "$ref": "#/$defs/text" },
    "attemptId": { "$ref": "#/$defs/text" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributionArtifactId",
        "invocationId",
        "sourceUnitKey",
        "sourceSemanticHash",
        "disposition",
        "canonicalNodeIds",
        "reviewIssueIds"
      ],
      "properties": {
        "contributionArtifactId": { "$ref": "#/$defs/id" },
        "invocationId": { "$ref": "#/$defs/id" },
        "sourceUnitKey": { "$ref": "#/$defs/id" },
        "sourceSemanticHash": { "$ref": "#/$defs/hash" },
        "disposition": { "enum": ["included", "merged", "conflicted", "omitted"] },
        "canonicalNodeIds": { "$ref": "#/$defs/idList" },
        "reason": { "$ref": "#/$defs/text" },
        "reviewIssueIds": { "$ref": "#/$defs/idList" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "included" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "canonicalNodeIds": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "enum": ["merged", "conflicted"] } },
            "required": ["disposition"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "canonicalNodeIds": { "minItems": 1 },
              "reviewIssueIds": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "disposition": { "const": "omitted" } },
            "required": ["disposition"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "canonicalNodeIds": { "maxItems": 0 },
              "reviewIssueIds": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
