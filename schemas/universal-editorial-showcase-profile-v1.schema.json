{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "universal-editorial-showcase-profile-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "viewport", "layout", "colors", "typography", "principles"],
  "properties": {
    "version": { "const": "universal-editorial-showcase-profile-v1" },
    "id": { "const": "universal-editorial-showcase-v1" },
    "viewport": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "const": 1440 }, "height": { "const": 900 } }
    },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["maxWidth", "railWidth"],
      "properties": {
        "maxWidth": { "type": "integer", "minimum": 900, "maximum": 1800 },
        "railWidth": { "type": "integer", "minimum": 160, "maximum": 320 }
      }
    },
    "colors": {
      "type": "object", "additionalProperties": false,
      "required": ["paper", "surface", "ink", "muted", "accent", "fact", "inference", "unknown", "method"],
      "patternProperties": { "^[a-z]+$": { "type": "string", "pattern": "^#[a-f0-9]{6}$" } }
    },
    "typography": {
      "type": "object", "additionalProperties": false, "required": ["display", "body"],
      "properties": {
        "display": { "type": "string", "minLength": 1, "maxLength": 256 },
        "body": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "principles": {
      "type": "object", "additionalProperties": false,
      "required": ["cardWallForbidden", "externalResourcesAllowed", "mobileRequired", "printRequired"],
      "properties": {
        "cardWallForbidden": { "const": true },
        "externalResourcesAllowed": { "const": false },
        "mobileRequired": { "const": false },
        "printRequired": { "const": false }
      }
    }
  }
}
