{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "research-strategy-content-patch-v1.schema.json",
  "title": "ResearchStrategyContentPatchV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "operations"],
  "properties": {
    "version": { "const": "research-strategy-content-patch-v1" },
    "mode": { "enum": ["structural_repair", "semantic_revision"] },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/replaceDirectAnswerBinding" },
          { "$ref": "#/$defs/replaceSupport" },
          { "$ref": "#/$defs/appendDirectAnswer" },
          { "$ref": "#/$defs/appendContentBlock" },
          { "$ref": "#/$defs/appendBlockItem" },
          { "$ref": "#/$defs/appendLimitation" },
          { "$ref": "#/$defs/appendOpenQuestion" },
          { "$ref": "#/$defs/replaceSemanticText" }
        ]
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "key": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionIds", "evidenceIds", "confidence", "status", "validationNeeded"],
      "properties": {
        "questionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "evidenceIds": { "$ref": "#/$defs/ids" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "status": { "enum": ["supported", "provisional"] },
        "validationNeeded": { "type": "string" }
      }
    },
    "directAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "question", "answer", "answerStatus", "evidenceIds", "confidence", "businessImplication", "recommendedAction", "validationNeeded"],
      "properties": {
        "questionId": { "$ref": "#/$defs/text" },
        "question": { "$ref": "#/$defs/text" },
        "answer": { "$ref": "#/$defs/text" },
        "answerStatus": { "enum": ["supported", "provisional", "unanswered"] },
        "evidenceIds": { "$ref": "#/$defs/ids" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "businessImplication": { "$ref": "#/$defs/text" },
        "recommendedAction": { "$ref": "#/$defs/text" },
        "validationNeeded": { "type": "string" }
      }
    },
    "evidenceFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "statement", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "statement": { "$ref": "#/$defs/text" },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "narrativeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "content", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "const": "narrative" },
        "title": { "$ref": "#/$defs/text" },
        "content": { "$ref": "#/$defs/text" },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "matrixCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "row", "column", "statement", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "row": { "$ref": "#/$defs/text" },
        "column": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "matrixBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "rows", "columns", "cells"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "enum": ["comparison_matrix", "strategy_map"] },
        "title": { "$ref": "#/$defs/text" },
        "rows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "columns": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/matrixCell" } }
      }
    },
    "mindNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "description", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "mindEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relationship"],
      "properties": {
        "from": { "$ref": "#/$defs/key" },
        "to": { "$ref": "#/$defs/key" },
        "relationship": { "$ref": "#/$defs/text" }
      }
    },
    "mindModelBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "nodes", "edges"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "const": "mind_model" },
        "title": { "$ref": "#/$defs/text" },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mindNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/mindEdge" } }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "statement", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "title": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "principlesBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "items"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "const": "design_principles" },
        "title": { "$ref": "#/$defs/text" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/principle" } }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "statement", "impact", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "title": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "impact": { "$ref": "#/$defs/text" },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "opportunityBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "items"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "const": "opportunity_backlog" },
        "title": { "$ref": "#/$defs/text" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/opportunity" } }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "priority", "action", "ownerType", "rationale", "validationMethod", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "priority": { "enum": ["P0", "P1", "P2"] },
        "action": { "$ref": "#/$defs/text" },
        "ownerType": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "validationMethod": { "$ref": "#/$defs/text" },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "actionBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "items"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "enum": ["prioritized_actions", "action_plan"] },
        "title": { "$ref": "#/$defs/text" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "channel", "role", "strategies", "support"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "channel": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "strategies": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "support": { "$ref": "#/$defs/support" }
      }
    },
    "channelBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "items"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "kind": { "const": "channel_strategies" },
        "title": { "$ref": "#/$defs/text" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/channel" } }
      }
    },
    "contentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/narrativeBlock" },
        { "$ref": "#/$defs/matrixBlock" },
        { "$ref": "#/$defs/mindModelBlock" },
        { "$ref": "#/$defs/principlesBlock" },
        { "$ref": "#/$defs/opportunityBlock" },
        { "$ref": "#/$defs/actionBlock" },
        { "$ref": "#/$defs/channelBlock" }
      ]
    },
    "blockItem": {
      "oneOf": [
        { "$ref": "#/$defs/matrixCell" },
        { "$ref": "#/$defs/mindNode" },
        { "$ref": "#/$defs/principle" },
        { "$ref": "#/$defs/opportunity" },
        { "$ref": "#/$defs/action" },
        { "$ref": "#/$defs/channel" }
      ]
    },
    "supportTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity", "key"],
          "properties": { "entity": { "const": "evidence_finding" }, "key": { "$ref": "#/$defs/key" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity", "key"],
          "properties": { "entity": { "const": "content_block" }, "key": { "$ref": "#/$defs/key" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity", "blockKey", "key"],
          "properties": {
            "entity": { "const": "content_item" },
            "blockKey": { "$ref": "#/$defs/key" },
            "key": { "$ref": "#/$defs/key" }
          }
        }
      ]
    },
    "replaceDirectAnswerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "questionId", "answerStatus", "evidenceIds", "confidence", "validationNeeded"],
      "properties": {
        "op": { "const": "replace_direct_answer_binding" },
        "questionId": { "$ref": "#/$defs/text" },
        "answerStatus": { "enum": ["supported", "provisional", "unanswered"] },
        "evidenceIds": { "$ref": "#/$defs/ids" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "validationNeeded": { "type": "string" },
        "reviewIssueId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "replaceSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "support"],
      "properties": {
        "op": { "const": "replace_support" },
        "target": { "$ref": "#/$defs/supportTarget" },
        "support": { "$ref": "#/$defs/support" },
        "reviewIssueId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "appendDirectAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "answer"],
      "properties": { "op": { "const": "append_direct_answer" }, "answer": { "$ref": "#/$defs/directAnswer" } }
    },
    "appendContentBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "block"],
      "properties": { "op": { "const": "append_content_block" }, "block": { "$ref": "#/$defs/contentBlock" } }
    },
    "appendBlockItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "blockKey", "item", "reviewIssueId", "reason"],
      "properties": {
        "op": { "const": "append_block_item" },
        "blockKey": { "$ref": "#/$defs/key" },
        "item": { "$ref": "#/$defs/blockItem" },
        "reviewIssueId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "appendLimitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "append_limitation" },
        "value": { "$ref": "#/$defs/text" },
        "reviewIssueId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "appendOpenQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value"],
      "properties": {
        "op": { "const": "append_open_question" },
        "value": { "$ref": "#/$defs/text" },
        "reviewIssueId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "semanticTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "key", "field"],
      "properties": {
        "entity": { "enum": ["draft", "direct_answer", "evidence_finding", "content_block", "content_item"] },
        "key": { "$ref": "#/$defs/text" },
        "parentKey": { "$ref": "#/$defs/key" },
        "field": {
          "enum": [
            "title", "decisionContext", "executiveAnswer", "methodSummary",
            "question", "answer", "businessImplication", "recommendedAction",
            "statement", "content", "impact", "action", "ownerType", "rationale",
            "validationMethod", "channel", "role", "strategies", "label", "description"
          ]
        }
      }
    },
    "replaceSemanticText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "value", "reviewIssueId", "reason"],
      "properties": {
        "op": { "const": "replace_semantic_text" },
        "reviewIssueId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" },
        "target": { "$ref": "#/$defs/semanticTarget" },
        "value": {
          "oneOf": [
            { "$ref": "#/$defs/text" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
          ]
        }
      }
    }
  }
}
