{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "industry-market-content-draft-v1.schema.json",
  "title": "IndustryMarketContentDraftV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "scope",
    "coverageLedger",
    "marketLandscape",
    "audienceSegments",
    "supplyLandscape",
    "competitorAnalysis",
    "jdDiagnosis",
    "validatedFindings",
    "gapMatrix",
    "positioning",
    "opportunities",
    "strategyChains",
    "designLanguage",
    "categoryAssets",
    "measurementPlan",
    "dataGaps"
  ],
  "properties": {
    "schemaVersion": {
      "const": "industry-market-content-draft-v1"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "coverageLedger": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "marketLandscape": {
      "$ref": "#/$defs/section"
    },
    "audienceSegments": {
      "$ref": "#/$defs/audience"
    },
    "supplyLandscape": {
      "$ref": "#/$defs/section"
    },
    "competitorAnalysis": {
      "$ref": "#/$defs/competitorAnalysis"
    },
    "jdDiagnosis": {
      "$ref": "#/$defs/section"
    },
    "validatedFindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "gapMatrix": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gapMatrixItem"
      }
    },
    "positioning": {
      "$ref": "#/$defs/positioning"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    },
    "strategyChains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strategyChain"
      }
    },
    "designLanguage": {
      "$ref": "#/$defs/section"
    },
    "categoryAssets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/categoryAsset"
      }
    },
    "measurementPlan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "dataGaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataGap"
      }
    },
    "contributionExclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unitId", "reason"],
        "properties": {
          "unitId": { "$ref": "#/$defs/text" },
          "reason": { "$ref": "#/$defs/text" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "nullableScalar": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "status": {
      "enum": [
        "supported",
        "provisional",
        "unavailable"
      ]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionIds",
        "evidenceIds",
        "status",
        "confidence",
        "validationNeeded"
      ],
      "properties": {
        "questionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "validationNeeded": {
          "type": "string"
        },
        "sourceContributionUnitIds": {
          "$ref": "#/$defs/ids"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "provisional",
                  "unavailable"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "validationNeeded": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "subcategories",
        "exclusions",
        "analysisDepth",
        "primaryFocus",
        "secondaryFocuses",
        "decisionAudience",
        "decisionGoal",
        "timeWindow"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/text"
        },
        "subcategories": {
          "$ref": "#/$defs/ids"
        },
        "exclusions": {
          "$ref": "#/$defs/ids"
        },
        "analysisDepth": {
          "enum": [
            "light",
            "medium",
            "heavy"
          ]
        },
        "primaryFocus": {
          "$ref": "#/$defs/text"
        },
        "secondaryFocuses": {
          "$ref": "#/$defs/ids"
        },
        "decisionAudience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "decisionGoal": {
          "$ref": "#/$defs/text"
        },
        "timeWindow": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "status",
        "summary",
        "evidenceIds",
        "gapIds"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G",
            "H",
            "I",
            "J"
          ]
        },
        "status": {
          "enum": [
            "supported",
            "partial",
            "unavailable"
          ]
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "gapIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "items"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "items",
        "basisType",
        "coreVariables",
        "supportingVariables",
        "sampleCoverage",
        "segments",
        "personas",
        "differences",
        "designImplications"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "basisType": {
          "enum": [
            "dataset_derived",
            "qualitative_draft",
            "simulation"
          ]
        },
        "coreVariables": {
          "$ref": "#/$defs/ids"
        },
        "supportingVariables": {
          "$ref": "#/$defs/ids"
        },
        "sampleCoverage": {
          "$ref": "#/$defs/text"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "personas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "designImplications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "competitorSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "rationale",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "dimensionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleId",
        "value",
        "evidenceIds"
      ],
      "properties": {
        "sampleId": {
          "$ref": "#/$defs/key"
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "dimensionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "values"
      ],
      "properties": {
        "dimension": {
          "$ref": "#/$defs/text"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionValue"
          }
        }
      }
    },
    "difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "statement",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "dimension": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "differenceId",
        "audience",
        "statement",
        "support"
      ],
      "properties": {
        "differenceId": {
          "$ref": "#/$defs/key"
        },
        "audience": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "visualEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sampleIds",
        "dimension",
        "assetId",
        "evidenceIds",
        "caption"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "sampleIds": {
          "$ref": "#/$defs/ids"
        },
        "dimension": {
          "$ref": "#/$defs/text"
        },
        "assetId": {
          "$ref": "#/$defs/text"
        },
        "evidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "caption": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "screenshotComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimension",
        "sampleIds",
        "assetIds",
        "caption"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "dimension": {
          "$ref": "#/$defs/text"
        },
        "sampleIds": {
          "$ref": "#/$defs/ids"
        },
        "assetIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "caption": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "competitorAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "items",
        "competitorSamples",
        "dimensionMatrix",
        "differences",
        "impacts",
        "visualEvidence",
        "screenshotComparisons"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "competitorSamples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/competitorSample"
          }
        },
        "dimensionMatrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimensionRow"
          }
        },
        "differences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/difference"
          }
        },
        "impacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/impact"
          }
        },
        "visualEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visualEvidence"
          }
        },
        "screenshotComparisons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/screenshotComparison"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "gapMatrixItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "userNeed",
        "jdState",
        "competitorSupply",
        "gapLevel",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "userNeed": {
          "$ref": "#/$defs/text"
        },
        "jdState": {
          "$ref": "#/$defs/text"
        },
        "competitorSupply": {
          "$ref": "#/$defs/text"
        },
        "gapLevel": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "exclusions",
        "support"
      ],
      "properties": {
        "statement": {
          "$ref": "#/$defs/text"
        },
        "exclusions": {
          "$ref": "#/$defs/ids"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "statement",
        "priority",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "strategyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "opportunityId",
        "title",
        "goal",
        "currentProblem",
        "currentEvidenceIds",
        "currentScreenshotAssetIds",
        "competitorReference",
        "competitorEvidenceIds",
        "designAction",
        "categoryAssetRefs",
        "ownerType",
        "measurement",
        "validationMethod",
        "wireframeAssetId",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "opportunityId": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "goal": {
          "$ref": "#/$defs/text"
        },
        "currentProblem": {
          "$ref": "#/$defs/text"
        },
        "currentEvidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "currentScreenshotAssetIds": {
          "$ref": "#/$defs/ids"
        },
        "competitorReference": {
          "$ref": "#/$defs/text"
        },
        "competitorEvidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "designAction": {
          "$ref": "#/$defs/text"
        },
        "categoryAssetRefs": {
          "$ref": "#/$defs/ids"
        },
        "ownerType": {
          "$ref": "#/$defs/text"
        },
        "measurement": {
          "$ref": "#/$defs/text"
        },
        "validationMethod": {
          "$ref": "#/$defs/text"
        },
        "wireframeAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "categoryAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "name",
        "fitness",
        "rationale",
        "benchmarkEvidenceIds",
        "collectedAt",
        "reviewStatus",
        "platformInheritance",
        "categoryDelta",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "family": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "fitness": {
          "enum": [
            "recommended",
            "optional",
            "unsuitable"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "benchmarkEvidenceIds": {
          "$ref": "#/$defs/ids"
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewStatus": {
          "enum": [
            "current",
            "pending_review",
            "outdated"
          ]
        },
        "platformInheritance": {
          "$ref": "#/$defs/text"
        },
        "categoryDelta": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "definition",
        "baseline",
        "target",
        "validationMethod",
        "support"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "definition": {
          "$ref": "#/$defs/text"
        },
        "baseline": {
          "$ref": "#/$defs/nullableScalar"
        },
        "target": {
          "$ref": "#/$defs/nullableScalar"
        },
        "validationMethod": {
          "$ref": "#/$defs/text"
        },
        "support": {
          "$ref": "#/$defs/support"
        }
      }
    },
    "dataGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dimensionIds",
        "statement",
        "impact",
        "resolutionPath"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/key"
        },
        "dimensionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H",
              "I",
              "J"
            ]
          }
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "impact": {
          "$ref": "#/$defs/text"
        },
        "resolutionPath": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
