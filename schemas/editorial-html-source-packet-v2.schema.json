{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "editorial-html-source-packet-v2",
  "title": "Editorial HTML Source Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "binding", "report", "groups", "units", "relations", "visualizationCandidates", "evidence", "assets", "deterministicAuditUnitIds", "presentationBrief"],
  "properties": {
    "version": { "const": "editorial-html-source-packet-v2" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "planVersionId", "attemptId", "sourceReportPackageId", "sourceReportPackageHash", "materialHash"],
      "properties": {
        "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "planVersionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "attemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceReportPackageId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceReportPackageHash": { "$ref": "#/$defs/sha256" },
        "materialHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverableType", "methodSummaryUnitId", "requiredQuestionIds", "requestedDeliverables"],
      "properties": {
        "deliverableType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "titleUnitId": { "$ref": "#/$defs/unitId" },
        "methodSummaryUnitId": { "$ref": "#/$defs/unitId" },
        "requiredQuestionIds": { "$ref": "#/$defs/stringArray" },
        "requestedDeliverables": { "$ref": "#/$defs/stringArray" }
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "titleUnitIds", "bodyUnitIds", "supportingUnitIds", "questionIds", "evidenceIds", "eligiblePresentations"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "role": { "enum": ["decision", "answer", "finding", "journey", "strategy", "action", "validation", "risk", "audit"] },
          "titleUnitIds": { "$ref": "#/$defs/unitIdArray" },
          "bodyUnitIds": { "$ref": "#/$defs/unitIdArray" },
          "supportingUnitIds": { "$ref": "#/$defs/unitIdArray" },
          "questionIds": { "$ref": "#/$defs/stringArray" },
          "evidenceIds": { "$ref": "#/$defs/stringArray" },
          "sequence": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "eligiblePresentations": { "$ref": "#/$defs/presentationArray" }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "role", "metricEligible", "sourceJsonPointer", "basisUnitIds", "evidenceIds", "questionIds", "requiredInBody", "requiredInOutput"],
        "properties": {
          "id": { "$ref": "#/$defs/unitId" },
          "value": { "type": ["string", "number", "boolean"] },
          "role": { "enum": ["claim", "recommendation", "risk", "validation", "context", "audit"] },
          "epistemicStatus": { "enum": ["fact", "inference", "unknown"] },
          "metricEligible": { "type": "boolean" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
          "groupId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sourceJsonPointer": { "type": "string", "pattern": "^/" },
          "basisUnitIds": { "$ref": "#/$defs/unitIdArray" },
          "evidenceIds": { "$ref": "#/$defs/stringArray" },
          "questionIds": { "$ref": "#/$defs/stringArray" },
          "requiredInBody": { "type": "boolean" },
          "requiredInOutput": { "type": "boolean" }
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromGroupId", "toGroupId", "kind", "sourceUnitIds"],
        "properties": {
          "fromGroupId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "toGroupId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "kind": { "enum": ["sequence", "supports", "contrasts", "depends_on", "validates", "contains"] },
          "sourceUnitIds": { "$ref": "#/$defs/unitIdArray" }
        }
      }
    },
    "visualizationCandidates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "sourceGroupIds", "sourceUnitIds", "eligibilityReason", "required"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "kind": { "$ref": "#/$defs/presentationKind" },
          "sourceGroupIds": { "$ref": "#/$defs/stringArray" },
          "sourceUnitIds": { "$ref": "#/$defs/unitIdArray" },
          "eligibilityReason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "required": { "type": "boolean" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "visualRole", "width", "height", "captionUnitId", "altTextUnitId", "evidenceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "visualRole": { "enum": ["standalone", "comparison-before", "comparison-after"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "captionUnitId": { "$ref": "#/$defs/unitId" },
          "altTextUnitId": { "$ref": "#/$defs/unitId" },
          "evidenceIds": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "deterministicAuditUnitIds": { "$ref": "#/$defs/unitIdArray" },
    "presentationBrief": { "$ref": "#/$defs/presentationBrief" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "unitId": { "type": "string", "pattern": "^emu_[a-f0-9]{64}$" },
    "stringArray": {
      "type": "array", "maxItems": 1000, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "unitIdArray": {
      "type": "array", "maxItems": 1000, "uniqueItems": true,
      "items": { "$ref": "#/$defs/unitId" }
    },
    "presentationKind": {
      "enum": ["decision-cover", "metric-cards", "truth-triad", "card-grid", "journey-flow", "strategy-matrix", "mind-model", "roadmap", "validation-gates", "risk-register", "visual-gallery", "narrative", "audit-appendix"]
    },
    "presentationArray": {
      "type": "array", "maxItems": 13, "uniqueItems": true,
      "items": { "$ref": "#/$defs/presentationKind" }
    },
    "presentationBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "objective", "readingOrder", "preferredPresentations", "constraints"],
      "properties": {
        "version": { "const": "editorial-presentation-brief-v1" },
        "id": { "const": "rich-editorial-v1" },
        "objective": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": { "enum": ["structure_clear", "content_detailed", "hierarchy_explicit", "presentation_varied", "reading_efficient"] }
        },
        "readingOrder": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": { "enum": ["decision", "evidence", "analysis", "strategy", "actions", "validation", "risks", "audit"] }
        },
        "preferredPresentations": { "$ref": "#/$defs/presentationArray" },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxMainSections", "maxConsecutiveNarrativeBlocks", "requireRiskSectionWhenEligible", "requireAuditAppendix", "decorativeNumbering", "interactiveForms"],
          "properties": {
            "maxMainSections": { "type": "integer", "minimum": 1, "maximum": 24 },
            "maxConsecutiveNarrativeBlocks": { "type": "integer", "minimum": 0, "maximum": 8 },
            "requireRiskSectionWhenEligible": { "type": "boolean" },
            "requireAuditAppendix": { "type": "boolean" },
            "decorativeNumbering": { "const": "css_counter_only" },
            "interactiveForms": { "const": false }
          }
        }
      }
    }
  }
}
