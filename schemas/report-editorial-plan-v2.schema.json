{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "report-editorial-plan-v2",
  "title": "Report Editorial Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "blueprint", "copyFragments"],
  "properties": {
    "version": { "const": "report-editorial-plan-v2" },
    "blueprint": { "$ref": "#/definitions/blueprint" },
    "copyFragments": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/definitions/copyFragment" }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "unitRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/nonEmptyString" }
    },
    "singleUnitRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/nonEmptyString" }
    },
    "singleUnitBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation", "unitRefs", "visibility"],
      "properties": {
        "presentation": {
          "enum": [
            "answer",
            "paragraph",
            "fact",
            "card-grid",
            "stage-flow",
            "image",
            "image-comparison",
            "chart"
          ]
        },
        "unitRefs": { "$ref": "#/definitions/singleUnitRefs" },
        "visibility": { "enum": ["always", "collapsible"] }
      }
    },
    "multiUnitBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation", "unitRefs", "visibility"],
      "properties": {
        "presentation": { "enum": ["list", "record-table", "priority-board"] },
        "unitRefs": { "$ref": "#/definitions/unitRefs" },
        "visibility": { "enum": ["always", "collapsible"] }
      }
    },
    "graphBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation", "unitRefs", "visibility", "variant"],
      "properties": {
        "presentation": { "const": "graph" },
        "unitRefs": { "$ref": "#/definitions/singleUnitRefs" },
        "visibility": { "enum": ["always", "collapsible"] },
        "variant": { "enum": ["linear", "hub_spoke", "two_sided"] }
      }
    },
    "block": {
      "oneOf": [
        { "$ref": "#/definitions/singleUnitBlock" },
        { "$ref": "#/definitions/multiUnitBlock" },
        { "$ref": "#/definitions/graphBlock" }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headingMode", "view", "prominence", "blocks"],
      "properties": {
        "headingMode": { "enum": ["view_label", "first_source_title"] },
        "view": { "enum": ["answers", "topics", "actions", "evidence", "analysis"] },
        "prominence": { "enum": ["primary", "supporting", "appendix"] },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/block" }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "style", "density", "sections"],
      "properties": {
        "version": { "const": "report-editorial-blueprint-v1" },
        "style": { "enum": ["editorial", "analytical", "operational"] },
        "density": { "enum": ["comfortable", "compact"] },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/section" }
        }
      }
    },
    "reportTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["report_title", "executive_summary"] }
      }
    },
    "sectionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sectionIndex"],
      "properties": {
        "kind": { "enum": ["section_title", "section_lead", "section_transition"] },
        "sectionIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "blockTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sectionIndex", "blockIndex"],
      "properties": {
        "kind": { "const": "block_digest" },
        "sectionIndex": { "type": "integer", "minimum": 0 },
        "blockIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "copyTarget": {
      "oneOf": [
        { "$ref": "#/definitions/reportTarget" },
        { "$ref": "#/definitions/sectionTarget" },
        { "$ref": "#/definitions/blockTarget" }
      ]
    },
    "copyFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "text", "sourceLeafIds"],
      "properties": {
        "target": { "$ref": "#/definitions/copyTarget" },
        "text": { "type": "string" },
        "sourceLeafIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
