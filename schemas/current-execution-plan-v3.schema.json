{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "current-execution-plan-v3.schema.json",
  "title": "CurrentExecutionPlanV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "execution_contract_version",
    "skill_invocations",
    "capability_demand_graph",
    "portfolio_summary",
    "contribution_requirements",
    "deliverable_type",
    "evidence_requirements",
    "problem_graph",
    "problem_graph_provenance",
    "capability_decisions",
    "steps",
    "candidate_metadata",
    "activated_nodes"
  ],
  "properties": {
    "task_id": { "type": "string" },
    "execution_contract_version": { "const": "current-execution-plan-v3" },
    "skill_invocations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skillInvocation" }
    },
    "capability_demand_graph": { "$ref": "#/$defs/capabilityDemandGraph" },
    "portfolio_summary": { "$ref": "#/$defs/portfolioSummary" },
    "contribution_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/contributionRequirement" }
    },
    "deliverable_type": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
    },
    "evidence_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRequirement" }
    },
    "problem_graph": { "$ref": "#/$defs/problemGraph" },
    "problem_graph_provenance": { "$ref": "#/$defs/problemGraphProvenance" },
    "capability_decisions": { "$ref": "#/$defs/capabilityDecisions" },
    "capability_gaps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capabilityGap" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "candidate_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "rationale", "tradeoffs"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "tradeoffs": { "$ref": "#/$defs/text" },
        "recommended": { "type": "boolean" }
      }
    },
    "planning_provenance": { "$ref": "#/$defs/planningProvenance" },
    "activated_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "contributionType": {
      "enum": [
        "market_landscape",
        "competitive_analysis",
        "persona",
        "jobs_to_be_done",
        "journey",
        "qualitative_insight",
        "voc",
        "satisfaction",
        "metrics",
        "funnel",
        "feature_adoption",
        "design_audit",
        "accessibility",
        "research_method",
        "prioritization",
        "strategy",
        "action_plan",
        "virtual_user_hypothesis"
      ]
    },
    "requestedArtifact": {
      "enum": [
        "executive_answers",
        "research_report",
        "strategy_map",
        "mind_model",
        "design_principles",
        "opportunity_backlog",
        "prioritized_actions",
        "channel_strategies",
        "action_plan"
      ]
    },
    "evidenceClass": {
      "enum": [
        "public_source",
        "screenshot",
        "user_input",
        "knowledge",
        "dataset",
        "simulation",
        "derived"
      ]
    },
    "capabilityDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "questionIds",
        "requestedArtifactTypes",
        "requiredEvidenceClasses",
        "requiredInputRoles",
        "priority"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/contributionType" },
        "questionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requestedArtifactTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requestedArtifact" }
        },
        "requiredEvidenceClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceClass" }
        },
        "requiredInputRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "priority": { "enum": ["required", "optional"] }
      }
    },
    "capabilityDemandGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "demands"],
      "properties": {
        "version": { "const": "capability-demand-graph-v1" },
        "demands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityDemand" }
        }
      }
    },
    "portfolioSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "selected", "rejected", "shared_prerequisites", "estimated_budget"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/candidateProfile" },
        "selected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["invocation_id", "skill_id", "role", "reason_codes", "estimated_steps"],
            "properties": {
              "invocation_id": { "$ref": "#/$defs/id" },
              "skill_id": { "$ref": "#/$defs/id" },
              "role": { "enum": ["contributor", "synthesizer"] },
              "reason_codes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
              "estimated_steps": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill_id", "reason_code", "related_ids"],
            "properties": {
              "skill_id": { "$ref": "#/$defs/id" },
              "reason_code": { "$ref": "#/$defs/text" },
              "related_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "shared_prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability_type", "capability_id", "consumer_skill_ids"],
            "properties": {
              "capability_type": { "enum": ["tool", "knowledge"] },
              "capability_id": { "$ref": "#/$defs/id" },
              "consumer_skill_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
            }
          }
        },
        "estimated_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_steps", "estimated_steps", "selected_contributor_count", "selected_skill_count", "required_demand_count", "optional_demand_count", "expanded_step_count", "expanded_step_limit"],
          "properties": {
            "max_steps": { "type": "integer", "minimum": 1 },
            "estimated_steps": { "type": "integer", "minimum": 1 },
            "selected_contributor_count": { "type": "integer", "minimum": 0 },
            "selected_skill_count": { "type": "integer", "minimum": 1 },
            "required_demand_count": { "type": "integer", "minimum": 0 },
            "optional_demand_count": { "type": "integer", "minimum": 0 },
          "expanded_step_count": { "type": "integer", "minimum": 1 },
          "expanded_step_limit": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "contributionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "demand_type",
        "question_ids",
        "requested_artifact_types",
        "owner_invocation_id",
        "corroborator_invocation_ids",
        "required"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "demand_type": { "$ref": "#/$defs/contributionType" },
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requested_artifact_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requestedArtifact" }
        },
        "owner_invocation_id": { "$ref": "#/$defs/id" },
        "corroborator_invocation_ids": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "required": { "type": "boolean" }
      }
    },
    "skillInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "skill_id",
        "role",
        "contribution_types",
        "question_ids",
        "requested_artifact_types",
        "depends_on_invocation_ids",
        "output_contract",
        "required",
        "failure_policy",
        "execution_mode",
        "step_nos"
      ],
      "properties": {
        "invocation_id": { "$ref": "#/$defs/id" },
        "skill_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["contributor", "synthesizer"] },
        "demand_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "contribution_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contributionType" }
        },
        "question_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "requested_artifact_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/requestedArtifact" }
        },
        "depends_on_invocation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "output_contract": { "$ref": "#/$defs/id" },
        "required": { "type": "boolean" },
        "failure_policy": { "enum": ["block", "gap"] },
        "execution_mode": { "enum": ["compiled", "legacy_single_call"] },
        "contract_version": { "const": "skill-execution-contract-v1" },
        "contract_hash": { "$ref": "#/$defs/hash" },
        "degraded_policy": { "enum": ["block", "gap"] },
        "skill_reference_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "hash"],
            "properties": {
              "path": { "$ref": "#/$defs/text" },
              "hash": { "$ref": "#/$defs/hash" }
            }
          }
        },
        "knowledge_references": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/knowledgeReference" }
        },
        "resource_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillResourceGap" }
        },
        "step_nos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "execution_mode": { "const": "compiled" } },
            "required": ["execution_mode"]
          },
          "then": {
            "required": [
              "contract_version",
              "contract_hash",
              "degraded_policy",
              "skill_reference_hashes",
              "knowledge_references",
              "resource_gaps"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["contract_version"] },
                { "required": ["contract_hash"] },
                { "required": ["degraded_policy"] },
                { "required": ["skill_reference_hashes"] },
                { "required": ["knowledge_references"] },
                { "required": ["resource_gaps"] }
              ]
            }
          }
        }
      ]
    },
    "knowledgeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceId", "resourceType", "sourcePath", "status", "contentHash", "required", "failurePolicy"],
      "properties": {
        "resourceId": { "$ref": "#/$defs/text" },
        "resourceType": { "$ref": "#/$defs/text" },
        "sourcePath": { "$ref": "#/$defs/text" },
        "status": { "enum": ["approved", "draft"] },
        "contentHash": { "$ref": "#/$defs/hash" },
        "required": { "type": "boolean" },
        "failurePolicy": { "enum": ["block", "gap"] },
        "queryId": { "$ref": "#/$defs/text" }
      }
    },
    "skillResourceGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "min_items", "selected_items", "failure_policy", "reason"],
      "properties": {
        "query_id": { "$ref": "#/$defs/text" },
        "min_items": { "type": "integer", "minimum": 1 },
        "selected_items": { "type": "integer", "minimum": 0 },
        "failure_policy": { "const": "gap" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptedClasses", "minimumCount", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "acceptedClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceClass" }
        },
        "minimumCount": { "type": "integer", "minimum": 0 },
        "required": { "type": "boolean" }
      }
    },
    "researchQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "rationale",
        "priority",
        "success_criterion_ids",
        "evidence_requirements",
        "acceptance_criteria",
        "depends_on"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "statement": { "$ref": "#/$defs/text" },
        "rationale": { "$ref": "#/$defs/text" },
        "priority": { "enum": ["required", "optional"] },
        "success_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "evidence_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceRequirement" }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "problemGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "questions"],
      "properties": {
        "version": { "const": "problem-graph-v1" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/researchQuestion" }
        }
      }
    },
    "problemGraphProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "modelName", "modelVersion", "promptHash", "traceId"],
      "properties": {
        "receiptId": { "type": "string", "format": "uuid" },
        "modelName": { "$ref": "#/$defs/text" },
        "modelVersion": { "$ref": "#/$defs/text" },
        "promptHash": { "$ref": "#/$defs/text" },
        "traceId": { "$ref": "#/$defs/text" }
      }
    },
    "capabilityReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "skill_inactive",
            "task_type_mismatch",
            "outcome_mismatch",
            "deliverable_mismatch",
            "composition_mode_mismatch",
            "contribution_type_mismatch",
            "required_tool_missing",
            "required_tool_inactive",
            "required_tool_health_unknown",
            "required_tool_unhealthy",
            "core_tool_real_adapter_unavailable",
            "approval_unavailable",
            "pending_input_required",
            "eligible"
          ]
        },
        "message": { "$ref": "#/$defs/text" },
        "related_id": { "$ref": "#/$defs/text" }
      }
    },
    "capabilityPendingInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "label", "multiple", "capability_id"],
      "properties": {
        "kind": { "enum": ["value", "visual"] },
        "role": { "$ref": "#/$defs/text" },
        "label": { "$ref": "#/$defs/text" },
        "multiple": { "type": "boolean" },
        "capability_id": { "$ref": "#/$defs/text" }
      }
    },
    "capabilityApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_type", "capability_id", "authority"],
      "properties": {
        "capability_type": { "enum": ["skill", "tool"] },
        "capability_id": { "$ref": "#/$defs/text" },
        "authority": { "enum": ["owner", "legal", "security"] }
      }
    },
    "optionalToolDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "status"],
      "properties": {
        "tool_id": { "$ref": "#/$defs/text" },
        "status": { "enum": ["available", "unavailable"] },
        "reason_code": {
          "enum": [
            "optional_tool_health_unknown",
            "optional_tool_unhealthy",
            "optional_tool_real_adapter_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "available" } }, "required": ["status"] },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["reason_code"] },
                { "required": ["message"] }
              ]
            }
          },
          "else": { "required": ["reason_code", "message"] }
        }
      ]
    },
    "skillComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "supported_outcomes", "compatible_deliverables", "required_input_roles", "optional_input_roles"],
      "properties": {
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["standalone", "contributor", "synthesizer"] } },
        "supported_outcomes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["plan", "answer"] } },
        "compatible_deliverables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "contribution_types": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/contributionType" } },
        "contribution_schema": { "$ref": "#/$defs/text" },
        "contribution_adapter": { "$ref": "#/$defs/text" },
        "required_input_roles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "optional_input_roles": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "shareable_prerequisites": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "standalone_reason": { "$ref": "#/$defs/text" }
      }
    },
    "capabilitySkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "task_types", "inputs", "outputs", "required_tools"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "path": { "$ref": "#/$defs/text" },
        "when_to_use": { "type": "string" },
        "owner": { "type": "string" },
        "status": { "enum": ["draft", "active", "deprecated"] },
        "task_types": { "type": "array", "items": { "type": "string" } },
        "intent_tags": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "visual_inputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "multiple_visual_inputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "outputs": { "type": "array", "items": { "type": "string" } },
        "input_schema": { "type": "string" },
        "output_schema": { "type": "string" },
        "payload_schema": { "type": "string" },
        "entry": { "type": "string" },
        "required_tools": { "type": "array", "items": { "type": "string" } },
        "optional_tools": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "execution_mode": { "enum": ["legacy_single_call", "compiled"] },
        "execution_contract": { "$ref": "#/$defs/text" },
        "cost_level": { "type": "string" },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "composition": { "$ref": "#/$defs/skillComposition" }
      }
    },
    "capabilityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "required_approvals", "reasons", "pending_inputs"],
      "properties": {
        "skill": { "$ref": "#/$defs/capabilitySkill" },
        "required_approvals": { "type": "array", "items": { "$ref": "#/$defs/capabilityApproval" } },
        "reasons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capabilityReason" } },
        "pending_inputs": { "type": "array", "items": { "$ref": "#/$defs/capabilityPendingInput" } },
        "optional_tool_decisions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/optionalToolDecision" } }
      }
    },
    "capabilityDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "rejected"],
      "properties": {
        "eligible": { "type": "array", "items": { "$ref": "#/$defs/capabilityDecision" } },
        "rejected": { "type": "array", "items": { "$ref": "#/$defs/capabilityDecision" } }
      }
    },
    "capabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_type", "capability_id", "code", "message"],
      "properties": {
        "capability_type": { "const": "tool" },
        "capability_id": { "$ref": "#/$defs/text" },
        "code": {
          "enum": [
            "optional_tool_health_unknown",
            "optional_tool_unhealthy",
            "optional_tool_real_adapter_unavailable"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_pointer", "source_step_no", "source_pointer"],
      "properties": {
        "target_pointer": { "type": "string", "pattern": "^/" },
        "source_step_no": { "type": "integer", "minimum": 1 },
        "source_pointer": { "type": "string", "pattern": "^/" },
        "optional": { "type": "boolean" },
        "include_artifact_identity": { "type": "boolean" }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "description"],
      "properties": {
        "pointer": { "type": "string", "pattern": "^/" },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_no",
        "step_name",
        "actor_type",
        "actor_id",
        "question_ids",
        "depends_on",
        "input",
        "input_bindings",
        "expected_outputs",
        "acceptance_criteria",
        "requires_approval",
        "fallback_actor_ids"
      ],
      "properties": {
        "step_no": { "type": "integer", "minimum": 1 },
        "step_name": { "$ref": "#/$defs/text" },
        "actor_type": { "enum": ["knowledge", "tool", "skill", "llm", "reviewer"] },
        "actor_id": { "$ref": "#/$defs/text" },
        "question_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "input": { "type": "object" },
        "input_bindings": { "type": "array", "items": { "$ref": "#/$defs/inputBinding" } },
        "expected_outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expectedOutput" } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "requires_approval": { "type": "boolean" },
        "approval_role": { "enum": ["owner", "legal", "security"] },
        "fallback_actor_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "skill_invocation_id": { "$ref": "#/$defs/id" },
        "skill_stage_id": { "$ref": "#/$defs/id" },
        "shared_stage_key": { "$ref": "#/$defs/id" },
        "shared_by_invocation_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "share_fingerprint": { "$ref": "#/$defs/hash" }
      },
      "allOf": [
        {
          "if": { "properties": { "requires_approval": { "const": true } } },
          "then": { "required": ["approval_role"] },
          "else": { "not": { "required": ["approval_role"] } }
        },
        {
          "if": {
            "anyOf": [
              { "required": ["shared_stage_key"] },
              { "required": ["shared_by_invocation_ids"] },
              { "required": ["share_fingerprint"] }
            ]
          },
          "then": {
            "required": ["shared_stage_key", "shared_by_invocation_ids", "share_fingerprint"]
          }
        }
      ]
    },
    "candidateProfile": {
      "enum": ["speed", "depth", "breadth", "focused", "mixed_method", "decision", "remediation"]
    },
    "planningProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "resolver_version",
        "scenario_catalog_hash",
        "signal_catalog_hash",
        "profile_spec_hash",
        "scenario_mapping_hash",
        "classification_method",
        "classifier_call_count",
        "primary_scenario_id",
        "secondary_scenario_ids",
        "confidence",
        "signals",
        "selected_profile_ids",
        "degradations"
      ],
      "properties": {
        "version": { "const": "planning-guidance-provenance-v1" },
        "resolver_version": { "enum": ["candidate-profile-resolver-v1", "candidate-profile-resolver-v2"] },
        "scenario_catalog_hash": { "$ref": "#/$defs/hash" },
        "signal_catalog_hash": { "$ref": "#/$defs/hash" },
        "profile_spec_hash": { "$ref": "#/$defs/hash" },
        "scenario_mapping_hash": { "$ref": "#/$defs/hash" },
        "classification_method": { "enum": ["rule", "classifier", "clarification", "direct_skill_bypass", "fixed_policy"] },
        "classifier_call_count": { "enum": [0, 1] },
        "primary_scenario_id": { "type": ["string", "null"], "minLength": 1 },
        "secondary_scenario_ids": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "confidence": { "enum": ["high", "medium", "low", null] },
        "signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal_id", "source_path"],
            "properties": {
              "signal_id": { "$ref": "#/$defs/text" },
              "source_path": {
                "enum": [
                  "raw_input",
                  "task.task_type",
                  "task.research_goal",
                  "task.target_audience",
                  "task.scope",
                  "task.constraints",
                  "task.success_criteria",
                  "task.expected_deliverables",
                  "problem_graph.evidence_requirements",
                  "available_material_roles"
                ]
              }
            }
          }
        },
        "selected_profile_ids": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/candidateProfile" } },
        "degradations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": { "$ref": "#/$defs/text" },
              "profile_id": { "$ref": "#/$defs/candidateProfile" }
            }
          }
        }
      }
    }
  }
}
