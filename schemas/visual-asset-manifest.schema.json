{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "visual-asset-manifest-v1",
  "title": "Visual Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "planVersionId",
    "attemptId",
    "assetId",
    "contentSha256",
    "mediaType",
    "byteSize",
    "width",
    "height",
    "exportPolicy",
    "source",
    "derivedFrom",
    "derivation",
    "manifestHash"
  ],
  "properties": {
    "version": { "const": "visual-asset-manifest-v1" },
    "taskId": { "$ref": "#/definitions/nonEmptyString" },
    "planVersionId": { "$ref": "#/definitions/nonEmptyString" },
    "attemptId": { "$ref": "#/definitions/nonEmptyString" },
    "assetId": { "$ref": "#/definitions/nonEmptyString" },
    "contentSha256": { "$ref": "#/definitions/sha256" },
    "mediaType": { "enum": ["image/png", "image/jpeg", "image/webp", "image/svg+xml"] },
    "byteSize": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "exportPolicy": { "enum": ["allow", "mask", "block"] },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "artifactId", "artifactContentSha256", "jsonPointer", "url"],
          "properties": {
            "kind": { "const": "tool_artifact" },
            "artifactId": { "$ref": "#/definitions/nonEmptyString" },
            "artifactContentSha256": { "$ref": "#/definitions/sha256" },
            "jsonPointer": { "type": "string", "pattern": "^/" },
            "url": { "type": "string", "pattern": "^https?://" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fileName"],
          "properties": {
            "kind": { "const": "user_upload" },
            "fileName": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "derived" } }
        }
      ]
    },
    "derivedFrom": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/definitions/lineage" }
      ]
    },
    "derivation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "overlayArtifactId"],
          "properties": {
            "kind": { "const": "annotation" },
            "overlayArtifactId": { "$ref": "#/definitions/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "heatmap" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "chartId", "specHash"],
          "properties": {
            "kind": { "const": "chart_svg" },
            "chartId": { "$ref": "#/definitions/nonEmptyString" },
            "specHash": { "$ref": "#/definitions/sha256" }
          }
        }
      ]
    },
    "manifestHash": { "$ref": "#/definitions/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "derived" } }
          }
        }
      },
      "then": {
        "properties": {
          "derivedFrom": { "$ref": "#/definitions/lineage" },
          "derivation": { "not": { "type": "null" } }
        }
      },
      "else": {
        "properties": {
          "derivedFrom": { "type": "null" },
          "derivation": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "derivation": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "chart_svg" } }
          }
        }
      },
      "then": { "properties": { "mediaType": { "const": "image/svg+xml" } } },
      "else": { "properties": { "mediaType": { "not": { "const": "image/svg+xml" } } } }
    }
  ],
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "manifestArtifactId", "contentSha256", "manifestHash"],
      "properties": {
        "assetId": { "$ref": "#/definitions/nonEmptyString" },
        "manifestArtifactId": { "$ref": "#/definitions/nonEmptyString" },
        "contentSha256": { "$ref": "#/definitions/sha256" },
        "manifestHash": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
