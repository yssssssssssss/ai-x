{
  "skill_id": "issue-prioritization",
  "title": "购物体验问题优先级排序",
  "research_goal": "在统一 90 天窗口内，对十个体验问题完成分层、严重度与 RICE/ICE 排序，形成 P0–P3 行动和快速收益项。",
  "input_materials": {
    "data_classification": "synthetic_evaluation_data",
    "scoring_rules": {
      "reach": "未来 90 天预计受影响的去重用户数，来自固定合成日志估算",
      "impact_scale": {"critical": 3, "high": 2, "medium": 1, "low": 0.5},
      "confidence": "0–1，依据日志、工单和研究证据一致性",
      "effort": "跨职能总人周",
      "rice_formula": "reach × impact × confidence ÷ effort",
      "ice_formula": "impact × confidence × ease，其中 ease=10÷effort"
    },
    "issues": [
      {"id": "I01", "issue": "支付失败后无恢复入口", "layer": "core_flow", "affected_users_90d": 8400, "severity_evidence": "阻断支付；错误码日志与 18 条工单一致", "impact": "critical", "business_impact": "订单无法完成", "confidence": 0.95, "effort_person_weeks": 3},
      {"id": "I02", "issue": "运费仅在提交前展示", "layer": "trust", "affected_users_90d": 22000, "severity_evidence": "12 场访谈中 7 场提及意外费用", "impact": "high", "business_impact": "结算放弃与信任下降", "confidence": 0.8, "effort_person_weeks": 2},
      {"id": "I03", "issue": "Android 筛选条件偶发失效", "layer": "core_flow", "affected_users_90d": 15500, "severity_evidence": "事件回放显示 6.2% 筛选会话未应用条件", "impact": "high", "business_impact": "搜索效率下降", "confidence": 0.9, "effort_person_weeks": 5},
      {"id": "I04", "issue": "配送改期无主动通知", "layer": "service", "affected_users_90d": 6100, "severity_evidence": "配送异常工单中占 14%", "impact": "high", "business_impact": "客服量与退款风险", "confidence": 0.75, "effort_person_weeks": 4},
      {"id": "I05", "issue": "优惠券最优组合不明确", "layer": "decision", "affected_users_90d": 28000, "severity_evidence": "可用券会话中 19% 反复切换", "impact": "medium", "business_impact": "决策时间增加", "confidence": 0.85, "effort_person_weeks": 3},
      {"id": "I06", "issue": "商品图偶发灰块", "layer": "reliability", "affected_users_90d": 9700, "severity_evidence": "图片加载错误率 1.8%", "impact": "medium", "business_impact": "详情理解受损", "confidence": 0.9, "effort_person_weeks": 2},
      {"id": "I07", "issue": "地址编辑图标无可访问名称", "layer": "accessibility", "affected_users_90d": 1300, "severity_evidence": "固定 VoiceOver 测试只朗读按钮", "impact": "critical", "business_impact": "读屏用户无法识别操作", "confidence": 0.95, "effort_person_weeks": 1},
      {"id": "I08", "issue": "发票入口位于折叠区", "layer": "secondary_flow", "affected_users_90d": 4200, "severity_evidence": "企业用户任务成功率 62%", "impact": "medium", "business_impact": "开票求助增加", "confidence": 0.7, "effort_person_weeks": 2},
      {"id": "I09", "issue": "搜索结果重复", "layer": "decision", "affected_users_90d": 31000, "severity_evidence": "重复 SKU 曝光会话占 11%", "impact": "low", "business_impact": "浏览效率下降", "confidence": 0.85, "effort_person_weeks": 4},
      {"id": "I10", "issue": "订单备注保存后不回显", "layer": "feedback", "affected_users_90d": 3600, "severity_evidence": "功能成功但用户无法确认，9 条工单", "impact": "medium", "business_impact": "重复编辑与客服确认", "confidence": 0.75, "effort_person_weeks": 1}
    ]
  },
  "tool_outputs": [],
  "expected_deliverables": [
    "先分层、再定 severity、最后排序并映射 P0–P3",
    "可复算的 RICE/ICE 表和公式代入过程",
    "impact-effort quadrant、分层小结、ordered actions 和 quick wins",
    "结论摘要、Top 3–5、排序自检和五部分本次运行说明"
  ],
  "risk_checks": [
    "missing factors visible；本 case 字段齐全，若计算仍发现缺口必须明确标待补而非补数",
    "arithmetic reproducible，Reach、Impact、Confidence、Effort 和公式不可隐去",
    "严重度不得直接等同优先级，必须综合覆盖、投入和置信度"
  ]
}
