{
  "skill_id": "competitive-analysis",
  "title": "购物助手综合竞品与机会分析",
  "research_goal": "为下一季度购物助手路线选择比较三家虚构竞品，并判断哪些动作值得跟进、差异化或放弃。",
  "input_materials": {
    "data_classification": "synthetic_evaluation_data",
    "decision_question": "我方应优先建设证据透明、自动比价还是协作清单能力？",
    "time_window": {"start": "2025-08-01", "end": "2026-07-31"},
    "self_context": {
      "product": "我方产品导购简报",
      "positioning": "帮助谨慎型消费者基于证据缩小候选集",
      "lifecycle": "早期验证",
      "target_users": "购买中高客单耐用品、愿意比较参数和来源的消费者",
      "current_strengths": ["逐条来源链接", "可保存比较结论"],
      "current_constraints": ["无跨店实时价格", "无多人协作"]
    },
    "competitors": ["选购星", "比价狐", "清单猫"],
    "dimensions": ["目标用户", "核心价值", "关键能力", "证据透明", "变现线索", "增长动作"]
  },
  "tool_outputs": [
    {
      "data_classification": "synthetic_evaluation_data",
      "tool": "fixed_source_records",
      "records": [
        {"id": "C1", "competitor": "选购星", "date": "2025-09-18", "url": "https://example.com/synthetic/c1", "fact": "发布参数并排比较与逐项来源链接。"},
        {"id": "C2", "competitor": "选购星", "date": "2026-04-09", "url": "https://example.com/synthetic/c2", "fact": "新增预算和使用场景追问。"},
        {"id": "C3", "competitor": "选购星", "date": "2026-06-30", "url": "https://example.com/synthetic/c3", "fact": "帮助页显示高级报告订阅价格。"},
        {"id": "C4", "competitor": "比价狐", "date": "2025-11-02", "url": "https://example.com/synthetic/c4", "fact": "上线跨店到手价和七日价格趋势。"},
        {"id": "C5", "competitor": "比价狐", "date": "2026-06-16", "url": "https://example.com/synthetic/c5", "fact": "声明部分跳转链接含佣金关系。"},
        {"id": "C6", "competitor": "清单猫", "date": "2025-12-12", "url": "https://example.com/synthetic/c6", "fact": "上线可共享购物清单。"},
        {"id": "C7", "competitor": "清单猫", "date": "2026-03-24", "url": "https://example.com/synthetic/c7", "fact": "新增清单评论与投票。"},
        {"id": "C8", "competitor": "清单猫", "date": "2026-07-05", "url": "https://example.com/synthetic/c8", "fact": "回答标记更新时间但未提供逐条来源链接。"}
      ]
    }
  ],
  "expected_deliverables": [
    "结论摘要与 Top 3–5 应对动作",
    "先写知己，再做竞品分层、五要素 fact table 和 capability/strategic comparison",
    "战略意图四问、AARRR/SWOT 辅助判断以及明确标推断的机会 hypotheses",
    "短中长期解读、跟进矩阵和差异化行动",
    "自检和五部分本次运行说明"
  ],
  "risk_checks": [
    "fact/inference separation，战略意图不得伪装成竞品官方事实",
    "opportunities marked for validation，差异必须经过跟进矩阵而非默认照抄",
    "每条外部事实保留 C1–C8 的 URL 和日期，不得扩写记录外动作或数据"
  ]
}
