{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Evaluation Scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "total_score",
    "verdict",
    "dimensions",
    "critical_defects",
    "review_notes"
  ],
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "total_score": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "needs_review", "fail"]
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "score", "max_score", "evidence", "defects"],
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0
          },
          "max_score": {
            "type": "number",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "defects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "critical_defects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
