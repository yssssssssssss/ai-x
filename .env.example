# PostgreSQL 连接(V0 用本机 Homebrew PG,免 docker)
DATABASE_URL=postgres://localhost:5432/user_research_ai
# API JWT 签名密钥；生产和真实 Smoke 必填，不得使用默认值
JWT_SECRET=

# LLM 通道:mock=预置 fixture(单测/离线);gateway=京东内网真实网关(默认)
LLM_PROVIDER=gateway
# 内网网关(OpenAI 兼容);key 从安全渠道注入本机 .env,勿提交
LLM_GATEWAY_BASE_URL=http://llm-gw.jd.local/v1
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_TIMEOUT_MS=90000
LLM_MODEL_NAME=GPT-5.2-joybuilder
# 网关实际返回的规范模型 ID；先做一次受控调用读取 response.model，再固定用于 drift 门禁
LLM_EXPECTED_ACTUAL_MODEL=
LLM_MODEL_VERSION=v0

# Tool 通道:V0=fake(FakeO2Adapter);二期切 o2 真实 adapter
TOOL_ADAPTER=fake

# Tavily 公开网页检索 tool(tavily-web-search)连接配置
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_MS=30000

# CURRENT_REAL_SMOKE is an explicit command-level gate; never persist ALLOW_REAL_PROVIDER in this file.
# CURRENT_REAL_SMOKE=1 is documentation only; invoke `pnpm smoke:current:real` with secure env injection.
# 真实 Current Smoke 前置（真实门禁环境）
# 1. pnpm db:migrate && pnpm db:seed
# 2. 按下表设置真实门禁必需变量（smoke 启动时 assertRealSmokeConfig 逐项断言非空，缺一即拒跑）：
#    - DATABASE_URL                Postgres 连接（受控测试库，非生产）
#    - JWT_SECRET                  API 签名密钥（从安全渠道注入，禁止默认值/提交）
#    - LLM_GATEWAY_BASE_URL        京东内网 LLM 网关地址（OpenAI 兼容）
#    - LLM_GATEWAY_API_KEY         网关访问密钥（从安全渠道注入本机 .env，勿提交）
#    - LLM_MODEL_NAME              请求路由别名（网关据此路由到后端模型）
#    - LLM_EXPECTED_ACTUAL_MODEL   网关实际返回的规范模型 ID（drift 门禁锚点）：
#                                  先做一次受控调用读取 response.model，再固定到此变量
#    - TAVILY_API_KEY              Tavily 公开网页检索密钥（tavily-web-search 真实 adapter）
# 3. 显式运行：ALLOW_REAL_PROVIDER=1 LLM_PROVIDER=gateway TOOL_ADAPTER=real pnpm smoke:current:real
#    - ALLOW_REAL_PROVIDER 是真实外部调用的显式闸门，只允许命令级注入，不持久化到 .env
#    - TOOL_ADAPTER=real 让 tool 走真实 Tavily adapter（默认 fake 走 FakeO2Adapter fixture）
#    - LLM_PROVIDER=gateway 走真实网关（mock 走预置 fixture，仅供单测/离线）

# 运行期工作区根目录(大对象/中间文件不进 PG)
RUN_WORKSPACE_ROOT=./run-workspaces

# ai-spider-app 竞品检索 tool(ai-spider-search)连接配置
SPIDER_BASE_URL=http://localhost:8000
SPIDER_USERNAME=
SPIDER_PASSWORD=
SPIDER_TIMEOUT_MS=30000

# external-tools/*-lab 工具后端地址(rest_json adapter 从这里读 base_url)
# 本机默认端口见 scripts/start-labs.mjs;各工具无鉴权
AESTHETIC_QUANT_BASE_URL=http://127.0.0.1:8801
ATTENTION_ANALYSIS_BASE_URL=http://127.0.0.1:8802
EXPERIENCE_MODEL_BASE_URL=http://127.0.0.1:8803
VIRTUAL_USER_BASE_URL=http://127.0.0.1:8804
VISION_BRAND_BASE_URL=http://127.0.0.1:8805
