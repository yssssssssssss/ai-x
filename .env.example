# PostgreSQL 连接(V0 用本机 Homebrew PG,免 docker)
DATABASE_URL=postgres://localhost:5432/user_research_ai
# API JWT 签名密钥；生产和真实 Smoke 必填，不得使用默认值
JWT_SECRET=

# 本地开发一键登录；仅在 NODE_ENV 非 production 时生效，账号必须已存在且为 active。
DEV_QUICK_LOGIN_EMAIL=seed@user-research.local

# LLM 通道:mock=预置 fixture(单测/离线);gateway=京东内网真实网关(默认)
LLM_PROVIDER=gateway
# 内网网关(OpenAI 兼容);key 从安全渠道注入本机 .env,勿提交
LLM_GATEWAY_BASE_URL=http://llm-gw.jd.local/v1
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_TIMEOUT_MS=90000
LLM_MODEL_NAME=GPT-5.5-joybuilder
# 网关实际返回的规范模型 ID；先做一次受控调用读取 response.model，再固定用于 drift 门禁
LLM_EXPECTED_ACTUAL_MODEL=gpt-5.5-2026-04-24
# 可选模型池：每次逻辑调用轮询起始模型；遇到429/quota立即切换下一个，成功结果仍按各自Actual Pin校验
LLM_MODEL_ROUTES=GPT-5.5-joybuilder=gpt-5.5-2026-04-24,GPT-5.4-joybuilder=gpt-5.4-2026-03-05,GPT-5.2-joybuilder=gpt-5.2-2025-12-11,GPT-5-joybuilder=gpt-5-2025-08-07
LLM_MODEL_VERSION=v0

# Tool 通道:V0=fake(FakeO2Adapter);二期切 o2 真实 adapter
TOOL_ADAPTER=fake

# Tavily 公开网页检索 tool(tavily-web-search)连接配置
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_MS=30000

# 网页视觉取证默认关闭；仅受保护的非 root/sandbox/egress Worker 可在进程启动前设为 1。
PLAYWRIGHT_CAPTURE_ENABLED=0

# Zero 报告发布默认关闭；仅支持与 Zero 桌面端同机的 loopback MCP。
ZERO_PUBLICATION_ENABLED=false
ZERO_MCP_URL=http://127.0.0.1:27618/mcp
ZERO_PUBLICATION_RECOVERY_INTERVAL_MS=30000

# CURRENT_REAL_SMOKE is an explicit command-level gate; never persist ALLOW_REAL_PROVIDER in this file.
# CURRENT_REAL_SMOKE=1 is documentation only; invoke `pnpm smoke:current:real` with secure env injection.
# 真实 Current Smoke 前置（真实门禁环境）
# 1. pnpm db:migrate && pnpm db:seed
# 2. 按下表设置真实门禁必需变量（smoke 启动时 assertRealSmokeConfig 逐项断言非空，缺一即拒跑）：
#    - DATABASE_URL                Postgres 连接（受控测试库，非生产）
#    - JWT_SECRET                  API 签名密钥（从安全渠道注入，禁止默认值/提交）
#    - LLM_GATEWAY_BASE_URL        京东内网 LLM 网关地址（OpenAI 兼容）
#    - LLM_GATEWAY_API_KEY         网关访问密钥（从安全渠道注入本机 .env，勿提交）
#    - LLM_MODEL_NAME              请求路由别名（网关据此路由到后端模型）
#    - LLM_EXPECTED_ACTUAL_MODEL   网关实际返回的规范模型 ID（drift 门禁锚点）：
#                                  先做一次受控调用读取 response.model，再固定到此变量
#    - LLM_MODEL_ROUTES            可选requested=expectedActual列表；配置后启用轮询和429/quota自动切换
#    - TAVILY_API_KEY              Tavily 公开网页检索密钥（tavily-web-search 真实 adapter）
#    - CURRENT_DESIGN_SMOKE_IMAGE_PATH  design_audit 的绝对本地图片路径（JPEG/PNG/WebP）
# 3. 显式运行：CURRENT_SMOKE_PROFILE=competitive_research CURRENT_SMOKE_SCENARIO=competitive-ai-shopping-assistant ALLOW_REAL_PROVIDER=1 LLM_PROVIDER=gateway TOOL_ADAPTER=real pnpm smoke:current:real
#    - ALLOW_REAL_PROVIDER 是真实外部调用的显式闸门，只允许命令级注入，不持久化到 .env
#    - TOOL_ADAPTER=real 让 tool 走真实 Tavily adapter（默认 fake 走 FakeO2Adapter fixture）
#    - LLM_PROVIDER=gateway 走真实网关（mock 走预置 fixture，仅供单测/离线）
#    - CURRENT_SMOKE_SCENARIO 必须与 CURRENT_SMOKE_PROFILE 精确匹配，不再隐式选择第一条 clear 场景
#    - 普通 CI 固定 CURRENT_REQUIRE_BROWSER_EVIDENCE=0；只有满足非 root、sandbox 和 egress 门禁的受保护环境才可设为 1
# 4. 受保护视觉验收追加命令级变量：PLAYWRIGHT_CAPTURE_ENABLED=1 CURRENT_REQUIRE_BROWSER_EVIDENCE=1
#    普通 GitHub-hosted CI 和未验证开发机禁止使用该组合访问公网目标。
CURRENT_SMOKE_PROFILE=competitive_research
CURRENT_SMOKE_SCENARIO=competitive-ai-shopping-assistant
CURRENT_REQUIRE_BROWSER_EVIDENCE=0
CURRENT_DESIGN_SMOKE_IMAGE_PATH=

# Trusted Gold 分阶段命令（共享同一 Postgres batch，collect/review/decide 不是一次同步流程）
# 当前 orchestrator/gold-policy.yaml 中 trusted_gold_enabled=false；保持关闭时三类命令都会在任何写入或真实调用前拒绝执行。
# 只有完成真实运行准备和独立人工评审安排后，才能由 gate owner 单独决定是否启用 policy。
# 1. collect：固定 build/registry/schema/policy pins，顺序采集三次真实 competitive_research Report Package
#    ALLOW_REAL_PROVIDER=1 LLM_PROVIDER=gateway TOOL_ADAPTER=real pnpm gold:run collect <batch_id>
# 2. review：独立 reviewer 对每个真实 attempt 异步提交一次结论；JWT 必须属于非 owner/operator/editor 的 reviewer
#    pnpm gold:run review <batch_id> <attempt_id> <usable|needs_revision|unusable>
# 3. decide：三次 attempt 都有合格独立评审后，重新验证 Report Package 并裁决 batch
#    pnpm gold:run decide <batch_id>
# 可选；未设置时依次使用 GITHUB_SHA 和当前 Git HEAD。启用 Gold 后同一 batch 必须保持不变。
GOLD_BUILD_ID=
# 仅 review 阶段需要；从安全渠道临时注入，不得提交真实 token。
GOLD_REVIEWER_JWT=

# 运行期工作区根目录(大对象/中间文件不进 PG)
RUN_WORKSPACE_ROOT=./run-workspaces

# ai-spider-app 竞品检索 tool(ai-spider-search)连接配置
SPIDER_BASE_URL=http://localhost:8000
SPIDER_USERNAME=
SPIDER_PASSWORD=
SPIDER_TIMEOUT_MS=30000

# external-tools/*-lab 工具后端地址(rest_json adapter 从这里读 base_url)
# 本机默认端口见 scripts/start-labs.mjs;各工具无鉴权
AESTHETIC_QUANT_BASE_URL=http://127.0.0.1:8801
ATTENTION_ANALYSIS_BASE_URL=http://127.0.0.1:8802
EXPERIENCE_MODEL_BASE_URL=http://127.0.0.1:8803
VIRTUAL_USER_BASE_URL=http://127.0.0.1:8804
VISION_BRAND_BASE_URL=http://127.0.0.1:8805
